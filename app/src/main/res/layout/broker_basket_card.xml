<?xml version="1.0" encoding="utf-8"?>

<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/broker_basket_card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layoutDirection="rtl"
    android:layout_marginStart="3dp"
    android:layout_marginTop="2dp"
    android:layout_marginEnd="3dp"
    android:layout_marginBottom="2dp"
    app:cardBackgroundColor="?attr/colorSurface"
    app:cardCornerRadius="10dp"
    app:cardElevation="1dp"
    app:strokeColor="?attr/colorPrimary"
    app:strokeWidth="1dp">

    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="142dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="5dp">

        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="86dp"
            android:layout_height="match_parent"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="78dp"
                android:layout_height="78dp"
                app:cardBackgroundColor="?attr/colorSurface"
                app:cardCornerRadius="8dp"
                app:cardElevation="0dp"
                app:strokeColor="?attr/colorPrimary"
                app:strokeWidth="1dp">

                <ImageView
                    android:id="@+id/b_basket_c_img"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/good_buy_imaga_Description"
                    android:padding="3dp"
                    android:scaleType="centerInside"
                    tools:src="@drawable/ic_search_product" />

            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/b_basket_c_offer"
                android:layout_width="match_parent"
                android:layout_height="20dp"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:text="@string/good_buy_offer"
                android:textColor="?attr/colorPrimary"
                android:textSize="10sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/b_basket_c_btndlt"
                style="@style/Widget.MaterialComponents.Button"
                android:layout_width="match_parent"
                android:layout_height="34dp"
                android:backgroundTint="@color/red_800"
                android:gravity="center"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingStart="3dp"
                android:paddingEnd="3dp"
                android:text="@string/good_buy_delete"
                android:textColor="@color/white"
                android:textSize="10sp"
                android:textStyle="bold"
                app:cornerRadius="7dp" />

        </androidx.appcompat.widget.LinearLayoutCompat>

        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="5dp"
            android:alpha="0.15"
            android:background="?attr/colorOnBackground" />

        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/b_basket_c_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:gravity="start|center_vertical"
                android:maxLines="2"
                android:minHeight="38dp"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:text="@string/good_buy_name"
                android:textColor="?attr/colorOnBackground"
                android:textSize="14sp"
                android:textStyle="bold"
                tools:text="نام کامل کالا و مشخصات اصلی محصول" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:alpha="0.12"
                android:background="?attr/colorOnBackground" />

            <androidx.appcompat.widget.LinearLayoutCompat
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:orientation="horizontal">

                <androidx.appcompat.widget.LinearLayoutCompat
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:maxLines="1"
                        android:text="@string/good_buy_sellprice"
                        android:textColor="?attr/colorOnBackground"
                        android:textSize="9sp" />

                    <TextView
                        android:id="@+id/b_basket_c_price"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:gravity="center"
                        android:maxLines="1"
                        android:text="@string/good_buy_sellprice"
                        android:textColor="?attr/colorPrimary"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        tools:text="۱۲۵,۰۰۰" />

                </androidx.appcompat.widget.LinearLayoutCompat>

                <View
                    android:layout_width="1dp"
                    android:layout_height="26dp"
                    android:layout_gravity="center_vertical"
                    android:alpha="0.12"
                    android:background="?attr/colorOnBackground" />

                <androidx.appcompat.widget.LinearLayoutCompat
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1.15"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:maxLines="1"
                        android:text="@string/good_buy_totalsellprice"
                        android:textColor="?attr/colorOnBackground"
                        android:textSize="9sp" />

                    <TextView
                        android:id="@+id/b_basket_c_total"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:gravity="center"
                        android:maxLines="1"
                        android:text="@string/good_buy_totalsellprice"
                        android:textColor="?attr/colorPrimary"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        tools:text="۲۵۰,۰۰۰" />

                </androidx.appcompat.widget.LinearLayoutCompat>

            </androidx.appcompat.widget.LinearLayoutCompat>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:alpha="0.12"
                android:background="?attr/colorOnBackground" />

            <androidx.appcompat.widget.LinearLayoutCompat
                android:layout_width="match_parent"
                android:layout_height="34dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/b_basket_c_maxprice"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:maxLines="1"
                    android:text="@string/good_buy_maxsellprice"
                    android:textColor="?attr/colorOnBackground"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    tools:text="حداکثر: ۱۳۰,۰۰۰" />

                <View
                    android:layout_width="1dp"
                    android:layout_height="23dp"
                    android:layout_gravity="center_vertical"
                    android:alpha="0.12"
                    android:background="?attr/colorOnBackground" />

                <TextView
                    android:id="@+id/b_basket_c_maxtotal"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1.1"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:maxLines="1"
                    android:text="@string/good_buy_totalmaxsellprice"
                    android:textColor="?attr/colorOnBackground"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    tools:text="جمع حداکثر: ۲۶۰,۰۰۰" />

            </androidx.appcompat.widget.LinearLayoutCompat>

            <androidx.appcompat.widget.LinearLayoutCompat
                android:layout_width="match_parent"
                android:layout_height="34dp"
                android:background="?attr/colorSecondary"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:paddingEnd="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="start|center_vertical"
                    android:text="@string/good_buy_amount"
                    android:textColor="?attr/colorOnSecondary"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/b_basket_c_amount"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:minWidth="48dp"
                    android:text="@string/good_buy_amount"
                    android:textColor="?attr/colorOnSecondary"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    tools:text="۲" />

            </androidx.appcompat.widget.LinearLayoutCompat>

        </androidx.appcompat.widget.LinearLayoutCompat>

    </androidx.appcompat.widget.LinearLayoutCompat>

</com.google.android.material.card.MaterialCardView>