<?xml version="1.0" encoding="utf-8"?>

<androidx.appcompat.widget.LinearLayoutCompat
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/ord_payment_b"
    android:layout_width="340dp"
    android:layout_height="570dp"
    android:layout_gravity="center"
    android:layoutDirection="rtl"
    android:orientation="vertical"
    android:padding="5dp">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:cardBackgroundColor="?attr/colorSurface"
        app:cardCornerRadius="10dp"
        app:cardElevation="3dp"
        app:strokeColor="?attr/colorPrimary"
        app:strokeWidth="1dp">

        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <!-- Header -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="?attr/colorPrimary"
                android:gravity="start|center_vertical"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="ثبت دریافت فاکتور"
                android:textColor="?attr/colorOnPrimary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <!-- Payment type -->
            <androidx.appcompat.widget.LinearLayoutCompat
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingStart="6dp"
                android:paddingTop="5dp"
                android:paddingEnd="6dp"
                android:paddingBottom="5dp">

                <Button
                    android:id="@+id/ord_payment_b_btn_cash"
                    style="@style/Widget.MaterialComponents.Button"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginEnd="2dp"
                    android:layout_weight="1"
                    android:backgroundTint="?attr/colorPrimary"
                    android:gravity="center"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:paddingStart="5dp"
                    android:paddingEnd="5dp"
                    android:text="پرداخت نقدی"
                    android:textColor="?attr/colorOnPrimary"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/ord_payment_b_btn_pos"
                    style="@style/Widget.MaterialComponents.Button"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="2dp"
                    android:layout_weight="1"
                    android:backgroundTint="?attr/colorSecondary"
                    android:gravity="center"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:paddingStart="5dp"
                    android:paddingEnd="5dp"
                    android:text="پرداخت با پوز"
                    android:textColor="@color/white"
                    android:textSize="10sp"
                    android:textStyle="bold" />

            </androidx.appcompat.widget.LinearLayoutCompat>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:alpha="0.15"
                android:background="?attr/colorOnBackground" />

            <androidx.core.widget.NestedScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:fillViewport="true"
                android:overScrollMode="never">

                <androidx.appcompat.widget.LinearLayoutCompat
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="7dp">

                    <!-- Invoice summary -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="30dp"
                        android:gravity="start|center_vertical"
                        android:paddingStart="5dp"
                        android:paddingEnd="5dp"
                        android:text="خلاصه فاکتور"
                        android:textColor="?attr/colorPrimary"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:layout_width="match_parent"
                        android:layout_height="42dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="92dp"
                            android:layout_height="match_parent"
                            android:gravity="start|center_vertical"
                            android:paddingStart="5dp"
                            android:text="جمع فاکتور"
                            android:textColor="?attr/colorOnBackground"
                            android:textSize="9sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/ord_payment_b_sumprice"
                            android:layout_width="0dp"
                            android:layout_height="34dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_editbox"
                            android:ellipsize="end"
                            android:gravity="center"
                            android:maxLines="1"
                            android:paddingStart="6dp"
                            android:paddingEnd="6dp"
                            android:textColor="?attr/colorOnBackground"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            tools:text="۱,۲۵۰,۰۰۰ ریال" />

                    </androidx.appcompat.widget.LinearLayoutCompat>

                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:layout_width="match_parent"
                        android:layout_height="42dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="92dp"
                            android:layout_height="match_parent"
                            android:gravity="start|center_vertical"
                            android:paddingStart="5dp"
                            android:text="ارزش افزوده"
                            android:textColor="?attr/colorOnBackground"
                            android:textSize="9sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/ord_payment_b_sumtaxmayor"
                            android:layout_width="0dp"
                            android:layout_height="34dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_editbox"
                            android:ellipsize="end"
                            android:gravity="center"
                            android:maxLines="1"
                            android:paddingStart="6dp"
                            android:paddingEnd="6dp"
                            android:textColor="?attr/colorOnBackground"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            tools:text="۱۲۵,۰۰۰ ریال" />

                    </androidx.appcompat.widget.LinearLayoutCompat>

                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:layout_width="match_parent"
                        android:layout_height="46dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="92dp"
                            android:layout_height="match_parent"
                            android:gravity="start|center_vertical"
                            android:paddingStart="5dp"
                            android:text="مبلغ کل"
                            android:textColor="?attr/colorOnBackground"
                            android:textSize="9sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/ord_payment_b_totalprice"
                            android:layout_width="0dp"
                            android:layout_height="38dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_editbox"
                            android:ellipsize="end"
                            android:gravity="center"
                            android:maxLines="1"
                            android:paddingStart="6dp"
                            android:paddingEnd="6dp"
                            android:textColor="?attr/colorPrimary"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            tools:text="۱,۳۷۵,۰۰۰ ریال" />

                    </androidx.appcompat.widget.LinearLayoutCompat>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="3dp"
                        android:alpha="0.12"
                        android:background="?attr/colorOnBackground" />

                    <!-- Payment state -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="30dp"
                        android:gravity="start|center_vertical"
                        android:paddingStart="5dp"
                        android:paddingEnd="5dp"
                        android:text="وضعیت دریافت"
                        android:textColor="?attr/colorPrimary"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:id="@+id/ord_payment_b_ll_received"
                        android:layout_width="match_parent"
                        android:layout_height="42dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="92dp"
                            android:layout_height="match_parent"
                            android:gravity="start|center_vertical"
                            android:paddingStart="5dp"
                            android:text="دریافت‌شده"
                            android:textColor="?attr/colorOnBackground"
                            android:textSize="9sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/ord_payment_b_received"
                            android:layout_width="0dp"
                            android:layout_height="34dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_editbox"
                            android:ellipsize="end"
                            android:gravity="center"
                            android:maxLines="1"
                            android:paddingStart="6dp"
                            android:paddingEnd="6dp"
                            android:textColor="?attr/colorPrimary"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            tools:text="۵۰۰,۰۰۰ ریال" />

                    </androidx.appcompat.widget.LinearLayoutCompat>

                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:id="@+id/ord_payment_b_ll_decrement"
                        android:layout_width="match_parent"
                        android:layout_height="42dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="92dp"
                            android:layout_height="match_parent"
                            android:gravity="start|center_vertical"
                            android:paddingStart="5dp"
                            android:text="تخفیف"
                            android:textColor="?attr/colorOnBackground"
                            android:textSize="9sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/ord_payment_b_decrement"
                            android:layout_width="0dp"
                            android:layout_height="34dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_editbox"
                            android:ellipsize="end"
                            android:gravity="center"
                            android:maxLines="1"
                            android:paddingStart="6dp"
                            android:paddingEnd="6dp"
                            android:textColor="?attr/colorOnBackground"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            tools:text="۵۰,۰۰۰ ریال" />

                    </androidx.appcompat.widget.LinearLayoutCompat>

                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:id="@+id/ord_payment_b_ll_notreceived"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="92dp"
                            android:layout_height="match_parent"
                            android:gravity="start|center_vertical"
                            android:paddingStart="5dp"
                            android:text="مانده"
                            android:textColor="?attr/colorOnBackground"
                            android:textSize="10sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/ord_payment_b_notreceived"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_editbox"
                            android:ellipsize="end"
                            android:gravity="center"
                            android:maxLines="1"
                            android:paddingStart="6dp"
                            android:paddingEnd="6dp"
                            android:textColor="@color/red_800"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            tools:text="۸۲۵,۰۰۰ ریال" />

                    </androidx.appcompat.widget.LinearLayoutCompat>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="3dp"
                        android:alpha="0.12"
                        android:background="?attr/colorOnBackground" />

                    <!-- Discount -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="30dp"
                        android:gravity="start|center_vertical"
                        android:paddingStart="5dp"
                        android:paddingEnd="5dp"
                        android:text="ثبت تخفیف"
                        android:textColor="?attr/colorPrimary"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:id="@+id/ord_payment_b_ll_edlable"
                        android:layout_width="match_parent"
                        android:layout_height="24dp"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_marginEnd="2dp"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:text="درصد تخفیف"
                            android:textColor="?attr/colorOnBackground"
                            android:textSize="8sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_marginStart="2dp"
                            android:layout_weight="2"
                            android:gravity="center"
                            android:text="مبلغ تخفیف"
                            android:textColor="?attr/colorOnBackground"
                            android:textSize="8sp"
                            android:textStyle="bold" />

                    </androidx.appcompat.widget.LinearLayoutCompat>

                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:id="@+id/ord_payment_b_ll_edpay"
                        android:layout_width="match_parent"
                        android:layout_height="46dp"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <EditText
                            android:id="@+id/ord_payment_b_selloff"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_marginEnd="2dp"
                            android:layout_weight="1"
                            android:autofillHints=""
                            android:background="@drawable/bg_editbox"
                            android:digits="0123456789."
                            android:gravity="center"
                            android:imeOptions="actionNext"
                            android:inputType="numberDecimal"
                            android:maxLength="5"
                            android:maxLines="1"
                            android:minHeight="0dp"
                            android:paddingStart="5dp"
                            android:paddingEnd="5dp"
                            android:selectAllOnFocus="true"
                            android:singleLine="true"
                            android:textColor="?attr/colorOnBackground"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            tools:ignore="LabelFor"
                            tools:text="10" />

                        <EditText
                            android:id="@+id/ord_payment_b_mablagh"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_marginStart="2dp"
                            android:layout_weight="2"
                            android:autofillHints=""
                            android:background="@drawable/bg_editbox"
                            android:digits="0123456789."
                            android:gravity="center"
                            android:imeOptions="actionNext"
                            android:inputType="numberDecimal"
                            android:maxLines="1"
                            android:minHeight="0dp"
                            android:paddingStart="5dp"
                            android:paddingEnd="5dp"
                            android:selectAllOnFocus="true"
                            android:singleLine="true"
                            android:textColor="?attr/colorOnBackground"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            tools:ignore="LabelFor"
                            tools:text="۵۰,۰۰۰" />

                    </androidx.appcompat.widget.LinearLayoutCompat>

                    <!-- Cash payment -->
                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:id="@+id/ord_payment_b_ll_cashtopay"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="92dp"
                            android:layout_height="match_parent"
                            android:gravity="start|center_vertical"
                            android:paddingStart="5dp"
                            android:text="دریافت نقدی"
                            android:textColor="?attr/colorOnBackground"
                            android:textSize="9sp"
                            android:textStyle="bold" />

                        <EditText
                            android:id="@+id/ord_payment_b_cashtopay"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_weight="1"
                            android:autofillHints=""
                            android:background="@drawable/bg_editbox"
                            android:digits="0123456789."
                            android:gravity="center"
                            android:imeOptions="actionNext"
                            android:inputType="numberDecimal"
                            android:maxLines="1"
                            android:minHeight="0dp"
                            android:paddingStart="6dp"
                            android:paddingEnd="6dp"
                            android:selectAllOnFocus="true"
                            android:singleLine="true"
                            android:textColor="?attr/colorPrimary"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            tools:ignore="LabelFor"
                            tools:text="۵۰۰,۰۰۰" />

                    </androidx.appcompat.widget.LinearLayoutCompat>

                    <!-- POS payment -->
                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:id="@+id/ord_payment_b_ll_postopay"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="92dp"
                            android:layout_height="match_parent"
                            android:gravity="start|center_vertical"
                            android:paddingStart="5dp"
                            android:text="دریافت پوز"
                            android:textColor="?attr/colorOnBackground"
                            android:textSize="9sp"
                            android:textStyle="bold" />

                        <EditText
                            android:id="@+id/ord_payment_b_postopay"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_weight="1"
                            android:autofillHints=""
                            android:background="@drawable/bg_editbox"
                            android:digits="0123456789."
                            android:gravity="center"
                            android:imeOptions="actionDone"
                            android:inputType="numberDecimal"
                            android:maxLines="1"
                            android:minHeight="0dp"
                            android:paddingStart="6dp"
                            android:paddingEnd="6dp"
                            android:selectAllOnFocus="true"
                            android:singleLine="true"
                            android:textColor="?attr/colorPrimary"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            tools:ignore="LabelFor"
                            tools:text="۸۲۵,۰۰۰" />

                    </androidx.appcompat.widget.LinearLayoutCompat>

                </androidx.appcompat.widget.LinearLayoutCompat>

            </androidx.core.widget.NestedScrollView>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:alpha="0.15"
                android:background="?attr/colorOnBackground" />

            <!-- Final action -->
            <Button
                android:id="@+id/ord_payment_b_btn_final"
                style="@style/Widget.MaterialComponents.Button"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginStart="7dp"
                android:layout_marginTop="6dp"
                android:layout_marginEnd="7dp"
                android:layout_marginBottom="7dp"
                android:backgroundTint="?attr/colorPrimary"
                android:gravity="center"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="ثبت دریافت"
                android:textColor="?attr/colorOnPrimary"
                android:textSize="11sp"
                android:textStyle="bold" />

        </androidx.appcompat.widget.LinearLayoutCompat>

    </com.google.android.material.card.MaterialCardView>

</androidx.appcompat.widget.LinearLayoutCompat>