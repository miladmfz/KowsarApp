<?xml version="1.0" encoding="utf-8"?>

<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/ocr_stacklocation_box"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layoutDirection="rtl"
    android:layout_marginStart="3dp"
    android:layout_marginTop="2dp"
    android:layout_marginEnd="3dp"
    android:layout_marginBottom="2dp"
    android:checkable="true"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="?attr/colorSurface"
    app:cardCornerRadius="10dp"
    app:cardElevation="1dp"
    app:checkedIconTint="@color/red_800"
    app:strokeColor="?attr/colorPrimary"
    app:strokeWidth="1dp">

    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/ocr_stacklocation_line"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layoutDirection="rtl"
        android:orientation="vertical"
        android:padding="6dp">

        <!-- Product information -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="116dp">

            <!-- Product image -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/ocr_stacklocation_image_card"
                android:layout_width="104dp"
                android:layout_height="104dp"
                app:cardBackgroundColor="?attr/colorSurface"
                app:cardCornerRadius="8dp"
                app:cardElevation="0dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:strokeColor="?attr/colorPrimary"
                app:strokeWidth="1dp">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <ImageView
                        android:id="@+id/ocr_stacklocation_c_img"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="تصویر کالا"
                        android:padding="3dp"
                        android:scaleType="centerInside"
                        tools:src="@drawable/img_base_no_photo" />

                    <TextView
                        android:id="@+id/ocr_stacklocation_c_totalstate"
                        android:layout_width="wrap_content"
                        android:layout_height="26dp"
                        android:layout_gravity="bottom|end"
                        android:layout_margin="4dp"
                        android:background="@drawable/bg_editbox"
                        android:ellipsize="end"
                        android:gravity="center"
                        android:maxLines="1"
                        android:minWidth="38dp"
                        android:paddingStart="5dp"
                        android:paddingEnd="5dp"
                        android:textColor="@color/red_800"
                        android:textSize="9sp"
                        android:textStyle="bold"
                        tools:text="کسری" />

                </FrameLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Product details -->
            <androidx.appcompat.widget.LinearLayoutCompat
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="6dp"
                android:orientation="vertical"
                app:layout_constraintEnd_toStartOf="@id/ocr_stacklocation_image_card"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <TextView
                    android:id="@+id/ocr_stacklocation_c_name"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:ellipsize="end"
                    android:gravity="start|center_vertical"
                    android:maxLines="2"
                    android:paddingStart="5dp"
                    android:paddingEnd="5dp"
                    android:textColor="?attr/colorOnBackground"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    tools:text="نام کامل کالای موجود در موقعیت انبار" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:alpha="0.12"
                    android:background="?attr/colorOnBackground" />

                <!-- Amount -->
                <androidx.appcompat.widget.LinearLayoutCompat
                    android:layout_width="match_parent"
                    android:layout_height="30dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="48dp"
                        android:layout_height="match_parent"
                        android:gravity="start|center_vertical"
                        android:paddingStart="4dp"
                        android:text="تعداد"
                        android:textColor="?attr/colorOnBackground"
                        android:textSize="8sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/ocr_stacklocation_c_amount"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:gravity="start|center_vertical"
                        android:maxLines="1"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp"
                        android:textColor="@color/red_800"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        tools:text="۱۲۵ عدد" />

                </androidx.appcompat.widget.LinearLayoutCompat>

                <!-- Stack location -->
                <androidx.appcompat.widget.LinearLayoutCompat
                    android:layout_width="match_parent"
                    android:layout_height="30dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="48dp"
                        android:layout_height="match_parent"
                        android:gravity="start|center_vertical"
                        android:paddingStart="4dp"
                        android:text="موقعیت"
                        android:textColor="?attr/colorOnBackground"
                        android:textSize="8sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/ocr_stacklocation_c_stacklocation"
                        android:layout_width="0dp"
                        android:layout_height="26dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_editbox"
                        android:ellipsize="end"
                        android:gravity="center"
                        android:maxLines="1"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp"
                        android:textColor="?attr/colorPrimary"
                        android:textSize="9sp"
                        android:textStyle="bold"
                        tools:text="راهرو ۱۰ - سکشن ۴" />

                </androidx.appcompat.widget.LinearLayoutCompat>

                <!-- Sell price -->
                <androidx.appcompat.widget.LinearLayoutCompat
                    android:layout_width="match_parent"
                    android:layout_height="30dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="48dp"
                        android:layout_height="match_parent"
                        android:gravity="start|center_vertical"
                        android:paddingStart="4dp"
                        android:text="قیمت"
                        android:textColor="?attr/colorOnBackground"
                        android:textSize="8sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/ocr_stacklocation_c_sellprice"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:gravity="start|center_vertical"
                        android:maxLines="1"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp"
                        android:textColor="?attr/colorPrimary"
                        android:textSize="9sp"
                        android:textStyle="bold"
                        tools:text="۱,۲۵۰,۰۰۰ ریال" />

                </androidx.appcompat.widget.LinearLayoutCompat>

            </androidx.appcompat.widget.LinearLayoutCompat>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/ocr_stacklocation_c_btn"
            style="@style/Widget.MaterialComponents.Button"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="5dp"
            android:backgroundTint="?attr/colorPrimary"
            android:gravity="center"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="انتخاب موقعیت کالا"
            android:textColor="?attr/colorOnPrimary"
            android:textSize="11sp"
            android:textStyle="bold"
            app:cornerRadius="8dp"

              />

    </androidx.appcompat.widget.LinearLayoutCompat>

</com.google.android.material.card.MaterialCardView>