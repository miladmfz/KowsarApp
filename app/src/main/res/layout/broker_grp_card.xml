<?xml version="1.0" encoding="utf-8"?>

<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/broker_grp_card"
    android:layout_width="wrap_content"
    android:layout_height="40dp"
    android:layout_gravity="start"
    android:layoutDirection="rtl"
    android:layout_marginStart="2dp"
    android:layout_marginTop="2dp"
    android:layout_marginEnd="2dp"
    android:layout_marginBottom="2dp"
    android:background="@drawable/bg_round_blue"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:minWidth="92dp"
    android:paddingStart="8dp"
    android:paddingEnd="10dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal">

                <ImageView
                    android:id="@+id/b_grp_c_image"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:contentDescription="باز و بسته کردن گروه"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_arrow_down"
                    app:tint="?attr/colorPrimary" />

                <TextView
                    android:id="@+id/b_grp_c_name"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_marginStart="6dp"
                    android:ellipsize="end"
                    android:gravity="center_vertical"
                    android:maxLines="1"
                    android:maxWidth="190dp"
                    android:text="@string/detail_buy"
                    android:textColor="?attr/colorOnBackground"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    tools:text="گروه محصولات غذایی" />

        </LinearLayout>

</FrameLayout>