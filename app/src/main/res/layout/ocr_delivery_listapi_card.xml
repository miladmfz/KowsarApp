<?xml version="1.0" encoding="utf-8"?>

<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/ocr_delivery_listapi_card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layoutDirection="rtl"
    android:layout_marginStart="3dp"
    android:layout_marginTop="2dp"
    android:layout_marginEnd="3dp"
    android:layout_marginBottom="2dp"
    android:checkable="true"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="?attr/colorSurface"
    app:cardCornerRadius="10dp"
    app:cardElevation="1dp"
    app:checkedIconTint="@color/red_800"
    app:strokeColor="?attr/colorPrimary"
    app:strokeWidth="1dp">

    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/ocr_delivery_listapi_c_ll_main"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layoutDirection="rtl"
        android:orientation="vertical"
        android:padding="6dp">

        <!-- Customer -->
        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="62dp"
                android:layout_height="match_parent"
                android:gravity="start|center_vertical"
                android:paddingStart="5dp"
                android:text="مشتری"
                android:textColor="?attr/colorOnBackground"
                android:textSize="9sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/ocr_delivery_listapi_c_customer"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:ellipsize="end"
                android:gravity="start|center_vertical"
                android:maxLines="2"
                android:paddingStart="5dp"
                android:paddingEnd="5dp"
                android:textColor="?attr/colorOnBackground"
                android:textSize="12sp"
                android:textStyle="bold"
                tools:text="فروشگاه نمونه مشتری" />

            <TextView
                android:id="@+id/ocr_delivery_listapi_c_customercode"
                android:layout_width="68dp"
                android:layout_height="34dp"
                android:background="@drawable/bg_editbox"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:textColor="?attr/colorPrimary"
                android:textSize="10sp"
                android:textStyle="bold"
                tools:text="۱۲۵۴۸" />

        </androidx.appcompat.widget.LinearLayoutCompat>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:alpha="0.12"
            android:background="?attr/colorOnBackground" />

        <!-- Collection explanation -->
        <LinearLayout
            android:id="@+id/ocr_delivery_listapi_c_ll_ocrexplain"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="5dp"
            android:paddingEnd="5dp"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                android:layout_width="76dp"
                android:layout_height="match_parent"
                android:gravity="start|center_vertical"
                android:text="جمع‌آوری"
                android:textColor="@color/red_800"
                android:textSize="9sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/ocr_delivery_listapi_c_ocrexplain"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:gravity="start|center_vertical"
                android:maxLines="1"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:textColor="@color/red_800"
                android:textSize="10sp"
                android:textStyle="bold"
                tools:text="بخشی از کالاها جمع‌آوری نشده است" />

        </LinearLayout>

        <!-- General explanation -->
        <LinearLayout
            android:id="@+id/ocr_delivery_listapi_c_ll_explain"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="5dp"
            android:paddingEnd="5dp"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                android:layout_width="76dp"
                android:layout_height="match_parent"
                android:gravity="start|center_vertical"
                android:text="توضیحات"
                android:textColor="?attr/colorOnBackground"
                android:textSize="9sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/ocr_delivery_listapi_c_explain"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:gravity="start|center_vertical"
                android:maxLines="1"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:textColor="?attr/colorOnBackground"
                android:textSize="10sp"
                tools:text="توضیحات ثبت‌شده برای تحویل فاکتور" />

        </LinearLayout>

        <!-- Factor states -->
        <LinearLayout
            android:id="@+id/ocr_delivery_listapi_c_ll_state"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="3dp"
            android:paddingEnd="3dp"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                android:id="@+id/ocr_delivery_listapi_c_hasshortage"
                android:layout_width="0dp"
                android:layout_height="30dp"
                android:layout_marginEnd="2dp"
                android:layout_weight="1"
                android:background="@drawable/bg_editbox"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:textColor="@color/red_800"
                android:textSize="9sp"
                android:textStyle="bold"
                tools:text="دارای کسری" />

            <TextView
                android:id="@+id/ocr_delivery_listapi_c_hasedited"
                android:layout_width="0dp"
                android:layout_height="30dp"
                android:layout_marginStart="2dp"
                android:layout_weight="1"
                android:background="@drawable/bg_editbox"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:textColor="@color/red_800"
                android:textSize="9sp"
                android:textStyle="bold"
                tools:text="ویرایش‌شده" />

        </LinearLayout>

        <!-- Factor code and delivery state -->
        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="64dp"
                android:layout_height="match_parent"
                android:gravity="start|center_vertical"
                android:paddingStart="5dp"
                android:text="کد فاکتور"
                android:textColor="?attr/colorOnBackground"
                android:textSize="9sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/ocr_delivery_listapi_c_privatecode"
                android:layout_width="82dp"
                android:layout_height="34dp"
                android:background="@drawable/bg_editbox"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:textColor="?attr/colorPrimary"
                android:textSize="10sp"
                android:textStyle="bold"
                tools:text="۱۴۰۵۲۵۸" />

            <TextView
                android:id="@+id/ocr_delivery_listapi_c_state"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_marginStart="5dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:paddingStart="5dp"
                android:paddingEnd="5dp"
                android:textColor="?attr/colorOnBackground"
                android:textSize="10sp"
                android:textStyle="bold"
                tools:text="آماده تحویل" />

        </androidx.appcompat.widget.LinearLayoutCompat>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:alpha="0.1"
            android:background="?attr/colorOnBackground" />

        <!-- Date and warehouse -->
        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="64dp"
                android:layout_height="match_parent"
                android:gravity="start|center_vertical"
                android:paddingStart="5dp"
                android:text="تاریخ سفارش"
                android:textColor="?attr/colorOnBackground"
                android:textSize="9sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/ocr_delivery_listapi_c_kowsardate"
                android:layout_width="94dp"
                android:layout_height="34dp"
                android:background="@drawable/bg_editbox"
                android:gravity="center"
                android:maxLines="1"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:textColor="?attr/colorOnBackground"
                android:textSize="10sp"
                android:textStyle="bold"
                tools:text="۱۴۰۵/۰۵/۱۲" />

            <TextView
                android:id="@+id/ocr_delivery_listapi_c_stackclass"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_marginStart="5dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:paddingStart="5dp"
                android:paddingEnd="5dp"
                android:textColor="?attr/colorPrimary"
                android:textSize="10sp"
                android:textStyle="bold"
                tools:text="انبار ۱" />

        </androidx.appcompat.widget.LinearLayoutCompat>

        <Button
            android:id="@+id/ocr_delivery_listapi_c_btn"
            style="@style/Widget.MaterialComponents.Button"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_marginTop="4dp"
            android:backgroundTint="?attr/colorPrimary"
            android:gravity="center"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="نمایش فاکتور"
            android:textColor="?attr/colorOnPrimary"
            android:textSize="11sp"
            android:textStyle="bold" />

        <View
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:layout_marginTop="3dp"
            android:background="?attr/colorPrimary" />

    </androidx.appcompat.widget.LinearLayoutCompat>

</com.google.android.material.card.MaterialCardView>