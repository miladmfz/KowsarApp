<?xml version="1.0" encoding="utf-8"?>

<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/order_basket_activity"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="rtl"
    android:background="?attr/colorSurface"
    tools:context=".activity.order.Order_BasketActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Toolbar -->
        <androidx.appcompat.widget.LinearLayoutCompat
            android:id="@+id/ord_basket_a_appbar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:elevation="3dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <androidx.appcompat.widget.Toolbar
                android:id="@+id/ord_basket_a_toolbar"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="?attr/colorPrimary"
                android:minHeight="52dp"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                app:title="@string/buyactivity_titlename"
                app:titleTextColor="?attr/colorOnPrimary" />

        </androidx.appcompat.widget.LinearLayoutCompat>

        <!-- Basket summary -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/ord_basket_summary_card"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="4dp"
            app:cardBackgroundColor="?attr/colorSurface"
            app:cardCornerRadius="10dp"
            app:cardElevation="1dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/ord_basket_a_appbar"
            app:strokeColor="?attr/colorPrimary"
            app:strokeWidth="1dp">

            <androidx.appcompat.widget.LinearLayoutCompat
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="5dp">

                <!-- Financial totals -->
                <androidx.appcompat.widget.LinearLayoutCompat
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginEnd="2dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_round"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="3dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="18dp"
                            android:gravity="center"
                            android:text="مبلغ کل"
                            android:textColor="?attr/colorOnBackground"
                            android:textSize="8sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/ord_basket_a_total_price"
                            android:layout_width="match_parent"
                            android:layout_height="30dp"
                            android:background="@drawable/bg_editbox"
                            android:ellipsize="end"
                            android:gravity="center"
                            android:maxLines="1"
                            android:paddingStart="3dp"
                            android:paddingEnd="3dp"
                            android:textColor="?attr/colorPrimary"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            tools:text="۱,۵۰۰,۰۰۰" />

                    </androidx.appcompat.widget.LinearLayoutCompat>

                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="2dp"
                        android:layout_marginEnd="2dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_round"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="3dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="18dp"
                            android:gravity="center"
                            android:text="دریافتی"
                            android:textColor="?attr/colorOnBackground"
                            android:textSize="8sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/ord_basket_a_total_resive"
                            android:layout_width="match_parent"
                            android:layout_height="30dp"
                            android:background="@drawable/bg_editbox"
                            android:ellipsize="end"
                            android:gravity="center"
                            android:maxLines="1"
                            android:paddingStart="3dp"
                            android:paddingEnd="3dp"
                            android:textColor="?attr/colorPrimary"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            tools:text="۱,۰۰۰,۰۰۰" />

                    </androidx.appcompat.widget.LinearLayoutCompat>

                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="2dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_round"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="3dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="18dp"
                            android:gravity="center"
                            android:text="مانده"
                            android:textColor="?attr/colorOnBackground"
                            android:textSize="8sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/ord_basket_a_total_notresive"
                            android:layout_width="match_parent"
                            android:layout_height="30dp"
                            android:background="@drawable/bg_editbox"
                            android:ellipsize="end"
                            android:gravity="center"
                            android:maxLines="1"
                            android:paddingStart="3dp"
                            android:paddingEnd="3dp"
                            android:textColor="@color/red_800"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            tools:text="۵۰۰,۰۰۰" />

                    </androidx.appcompat.widget.LinearLayoutCompat>

                </androidx.appcompat.widget.LinearLayoutCompat>

                <!-- Basket totals -->
                <androidx.appcompat.widget.LinearLayoutCompat
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="3dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:layout_width="0dp"
                        android:layout_height="42dp"
                        android:layout_marginEnd="2dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_round"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="5dp"
                        android:paddingEnd="5dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:gravity="start|center_vertical"
                            android:text="@string/buyactivity_rowcount"
                            android:textColor="?attr/colorOnBackground"
                            android:textSize="8sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/ord_basket_a_total_row_buy"
                            android:layout_width="48dp"
                            android:layout_height="30dp"
                            android:background="@drawable/bg_editbox"
                            android:gravity="center"
                            android:maxLines="1"
                            android:textColor="?attr/colorPrimary"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            tools:text="۱۲" />

                    </androidx.appcompat.widget.LinearLayoutCompat>

                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:layout_width="0dp"
                        android:layout_height="42dp"
                        android:layout_marginStart="2dp"
                        android:layout_marginEnd="2dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_round"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="5dp"
                        android:paddingEnd="5dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:gravity="start|center_vertical"
                            android:text="@string/buyactivity_totalamount"
                            android:textColor="?attr/colorOnBackground"
                            android:textSize="8sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/ord_basket_a_total_amount_buy"
                            android:layout_width="48dp"
                            android:layout_height="30dp"
                            android:background="@drawable/bg_editbox"
                            android:gravity="center"
                            android:maxLines="1"
                            android:textColor="?attr/colorPrimary"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            tools:text="۳۵" />

                    </androidx.appcompat.widget.LinearLayoutCompat>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/ord_basket_a_total_delete"
                        style="@style/Widget.MaterialComponents.Button"
                        android:layout_width="92dp"
                        android:layout_height="42dp"
                        android:layout_marginStart="2dp"
                        android:backgroundTint="@color/red_800"
                        android:gravity="center"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp"
                        android:text="@string/buyactivity_delete"
                        android:textColor="@color/white"
                        android:textSize="9sp"
                        android:textStyle="bold"
                        android:visibility="gone"
                        app:cornerRadius="8dp"


                        tools:visibility="visible" />

                </androidx.appcompat.widget.LinearLayoutCompat>

            </androidx.appcompat.widget.LinearLayoutCompat>

        </com.google.android.material.card.MaterialCardView>

        <!-- Lists and states -->
        <FrameLayout
            android:id="@+id/ord_basket_content"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginStart="4dp"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="4dp"
            android:layout_marginBottom="4dp"
            app:layout_constraintBottom_toTopOf="@id/ord_basket_actions"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/ord_basket_summary_card">

            <ListView
                android:id="@+id/ord_basket_a_Listview"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:divider="@android:color/transparent"
                android:dividerHeight="2dp"
                android:paddingBottom="6dp"
                android:scrollbars="vertical"
                tools:listitem="@android:layout/simple_list_item_1" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/ord_basket_a_R1"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:overScrollMode="never"
                android:paddingBottom="6dp"
                android:scrollbars="vertical"
                tools:listitem="@android:layout/simple_list_item_1" />

            <com.airbnb.lottie.LottieAnimationView
                android:id="@+id/ord_basket_a_prog"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="center"
                app:lottie_autoPlay="true"
                app:lottie_loop="true"
                app:lottie_rawRes="@raw/loading" />

            <androidx.appcompat.widget.LinearLayoutCompat
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="8dp">

                <com.airbnb.lottie.LottieAnimationView
                    android:id="@+id/ord_basket_a_lottie"
                    android:layout_width="150dp"
                    android:layout_height="150dp"
                    android:visibility="gone"
                    app:lottie_autoPlay="true"
                    app:lottie_loop="true"
                    app:lottie_rawRes="@raw/notfind"
                    tools:visibility="visible" />

                <TextView
                    android:id="@+id/ord_basket_a_tvstatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:maxLines="2"
                    android:padding="6dp"
                    android:textColor="?attr/colorOnBackground"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    tools:text="سبد خرید خالی است" />

            </androidx.appcompat.widget.LinearLayoutCompat>

        </FrameLayout>

        <!-- Bottom actions -->
        <androidx.appcompat.widget.LinearLayoutCompat
            android:id="@+id/ord_basket_actions"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:background="?attr/colorSurface"
            android:elevation="6dp"
            android:gravity="center"
            android:orientation="horizontal"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/ord_basket_a_ordertofactor"
                style="@style/Widget.MaterialComponents.Button"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="5dp"
                android:layout_marginTop="5dp"
                android:layout_marginEnd="2dp"
                android:layout_marginBottom="5dp"
                android:layout_weight="1"
                android:backgroundTint="?attr/colorPrimary"
                android:gravity="center"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:text="@string/buyactivity_finalstep"
                android:textColor="?attr/colorOnPrimary"
                android:textSize="11sp"
                android:textStyle="bold"
                android:visibility="gone"
                app:cornerRadius="8dp"


                tools:visibility="visible" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/ord_basket_a_payment"
                style="@style/Widget.MaterialComponents.Button"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="2dp"
                android:layout_marginTop="5dp"
                android:layout_marginEnd="5dp"
                android:layout_marginBottom="5dp"
                android:layout_weight="1"
                android:backgroundTint="?attr/colorSecondary"
                android:gravity="center"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:text="پرداخت"
                android:textColor="@color/white"
                android:textSize="11sp"
                android:textStyle="bold"
                android:visibility="gone"
                app:cornerRadius="8dp"


                tools:visibility="visible" />

        </androidx.appcompat.widget.LinearLayoutCompat>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>