<?xml version="1.0" encoding="utf-8"?>

<androidx.appcompat.widget.LinearLayoutCompat
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/ocr_goodscan_box"
    android:layout_width="340dp"
    android:layout_height="520dp"
    android:layout_gravity="center"
    android:layoutDirection="rtl"
    android:orientation="vertical"
    android:padding="5dp">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:cardBackgroundColor="?attr/colorSurface"
        app:cardCornerRadius="10dp"
        app:cardElevation="3dp"
        app:strokeColor="?attr/colorPrimary"
        app:strokeWidth="1dp">

        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layoutDirection="rtl"
            android:orientation="vertical">

            <!-- Hidden barcode receiver -->
            <EditText
                android:id="@+id/ocr_goodscan_b_ed"
                android:layout_width="1dp"
                android:layout_height="1dp"
                android:alpha="0.01"
                android:autofillHints=""
                android:background="@android:color/transparent"
                android:hint="جستجو ..."
                android:imeOptions="actionDone"
                android:inputType="text"
                android:singleLine="true"
                android:textColor="?attr/colorOnBackground"
                android:visibility="visible"
                tools:ignore="SmallSp" />

            <!-- Header -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="?attr/colorPrimary"
                android:gravity="start|center_vertical"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="کالاهای اسکن‌شده"
                android:textColor="?attr/colorOnPrimary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <!-- Status -->
            <TextView
                android:id="@+id/ocr_goodscan_b_status"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:ellipsize="end"
                android:gravity="start|center_vertical"
                android:maxLines="1"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text=" "
                android:textColor="?attr/colorOnBackground"
                android:textSize="11sp"
                android:textStyle="bold"
                tools:text="تعداد کالاهای اسکن‌شده: ۱۲" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:alpha="0.15"
                android:background="?attr/colorOnBackground" />

            <!-- Scanned goods -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/ocr_goodscan_b_recyclerView"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:overScrollMode="never"
                android:paddingStart="4dp"
                android:paddingTop="4dp"
                android:paddingEnd="4dp"
                android:paddingBottom="6dp"
                android:scrollbars="vertical"
                tools:listitem="@android:layout/simple_list_item_2" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:alpha="0.15"
                android:background="?attr/colorOnBackground" />

            <!-- Action -->
            <Button
                android:id="@+id/ocr_goodscan_b_btn"
                style="@style/Widget.MaterialComponents.Button"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginStart="6dp"
                android:layout_marginTop="5dp"
                android:layout_marginEnd="6dp"
                android:layout_marginBottom="6dp"
                android:backgroundTint="?attr/colorPrimary"
                android:gravity="center"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="بازگشت"
                android:textColor="?attr/colorOnPrimary"
                android:textSize="11sp"
                android:textStyle="bold" />

        </androidx.appcompat.widget.LinearLayoutCompat>

    </com.google.android.material.card.MaterialCardView>

</androidx.appcompat.widget.LinearLayoutCompat>