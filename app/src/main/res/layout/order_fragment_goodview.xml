<?xml version="1.0" encoding="utf-8"?>

<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="rtl"
    android:background="?attr/colorSurface"
    tools:context=".fragment.order.Order_SearchViewFragment">

    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layoutDirection="rtl"
        android:orientation="horizontal"
        android:padding="4dp">

        <!-- Groups -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="2dp"
            android:layout_weight="3"
            app:cardBackgroundColor="?attr/colorSurface"
            app:cardCornerRadius="10dp"
            app:cardElevation="1dp"
            app:strokeColor="?attr/colorPrimary"
            app:strokeWidth="1dp">

            <androidx.appcompat.widget.LinearLayoutCompat
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="38dp"
                    android:gravity="start|center_vertical"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:text="گروه‌های کالا"
                    android:textColor="?attr/colorPrimary"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:alpha="0.14"
                    android:background="?attr/colorOnBackground" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/ord_fragment_grp_recy"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:clipToPadding="false"
                    android:overScrollMode="never"
                    android:padding="3dp"
                    android:scrollbars="vertical"
                    tools:listitem="@android:layout/simple_list_item_1" />

            </androidx.appcompat.widget.LinearLayoutCompat>

        </com.google.android.material.card.MaterialCardView>

        <!-- Products -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="2dp"
            android:layout_weight="1"
            app:cardBackgroundColor="?attr/colorSurface"
            app:cardCornerRadius="10dp"
            app:cardElevation="1dp"
            app:strokeColor="?attr/colorPrimary"
            app:strokeWidth="1dp">

            <androidx.appcompat.widget.LinearLayoutCompat
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:padding="5dp">

                <Button
                    android:id="@+id/ord_fragment_good_to_order"
                    style="@style/Widget.MaterialComponents.Button"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:backgroundTint="?attr/colorPrimary"
                    android:gravity="center"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:paddingStart="5dp"
                    android:paddingEnd="5dp"
                    android:text="@string/fragment_good_to_order"
                    android:textColor="?attr/colorOnPrimary"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/ord_fragment_good_search"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:layout_marginTop="5dp"
                    android:autofillHints=""
                    android:background="@drawable/bg_editbox"
                    android:gravity="start|center_vertical"
                    android:hint="جستجوی کالا"
                    android:imeOptions="actionSearch"
                    android:inputType="text"
                    android:maxLines="1"
                    android:paddingStart="9dp"
                    android:paddingEnd="9dp"
                    android:singleLine="true"
                    android:textColor="?attr/colorOnBackground"
                    android:textColorHint="?attr/colorOnBackground"
                    android:textSize="10sp"
                    tools:ignore="LabelFor" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="32dp"
                    android:gravity="start|center_vertical"
                    android:paddingStart="5dp"
                    android:paddingEnd="5dp"
                    android:text="لیست کالاها"
                    android:textColor="?attr/colorPrimary"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:alpha="0.14"
                    android:background="?attr/colorOnBackground" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1">

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/ord_fragment_good_recy"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:clipToPadding="false"
                        android:overScrollMode="never"
                        android:padding="2dp"
                        android:scrollbars="vertical"
                        tools:listitem="@android:layout/simple_list_item_1" />

                    <com.airbnb.lottie.LottieAnimationView
                        android:id="@+id/ord_fragment_good_prog"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_gravity="center"
                        app:lottie_autoPlay="true"
                        app:lottie_loop="true"
                        app:lottie_rawRes="@raw/loading" />

                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="5dp">

                        <com.airbnb.lottie.LottieAnimationView
                            android:id="@+id/ord_fragment_good_lottie"
                            android:layout_width="120dp"
                            android:layout_height="120dp"
                            android:visibility="gone"
                            app:lottie_autoPlay="true"
                            app:lottie_loop="true"
                            app:lottie_rawRes="@raw/notfind"
                            tools:visibility="visible" />

                        <TextView
                            android:id="@+id/ord_fragment_good_tvstatus"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:maxLines="3"
                            android:padding="5dp"
                            android:textColor="?attr/colorOnBackground"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            tools:text="کالایی برای نمایش پیدا نشد" />

                    </androidx.appcompat.widget.LinearLayoutCompat>

                </FrameLayout>

            </androidx.appcompat.widget.LinearLayoutCompat>

        </com.google.android.material.card.MaterialCardView>

    </androidx.appcompat.widget.LinearLayoutCompat>

</FrameLayout>