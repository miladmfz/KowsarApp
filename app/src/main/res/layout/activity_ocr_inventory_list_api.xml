<?xml version="1.0" encoding="utf-8"?>

<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="rtl"
    android:background="?attr/colorSurface"
    tools:context=".activity.ocr.Ocr_StackEnumeration_List_Api_Activity">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/ocr_inventorylist_a_appbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorPrimary"
        app:elevation="@dimen/elevationMedium">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/ocr_inventorylist_a_toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="?attr/colorPrimary"
            app:contentInsetEndWithActions="@dimen/gapMedium"
            app:contentInsetStartWithNavigation="@dimen/gapMedium"
            app:title="@string/ocr_inventory_title"
            app:titleCentered="true"
            app:titleTextColor="?attr/colorOnPrimary" />

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/ocr_inventorylist_a_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingStart="@dimen/gapLarge"
        android:paddingTop="@dimen/gapMedium"
        android:paddingEnd="@dimen/gapLarge"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/ocr_inventorylist_a_search_card"
            android:layout_width="0dp"
            android:layout_height="@dimen/controlHeight"
            app:cardBackgroundColor="?attr/colorSurface"
            app:cardCornerRadius="@dimen/radiusLarge"
            app:cardElevation="@dimen/elevationSmall"
            app:strokeColor="?attr/colorPrimary"
            app:strokeWidth="1dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/gapLarge"
                android:paddingEnd="@dimen/gapSmall">

                <androidx.appcompat.widget.AppCompatEditText
                    android:id="@+id/ocr_inventorylist_a_edtsearch"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:gravity="start|center_vertical"
                    android:hint="@string/ocr_inventory_search_hint"
                    android:imeOptions="actionSearch"
                    android:inputType="text"
                    android:maxLines="1"
                    android:paddingStart="0dp"
                    android:paddingEnd="@dimen/gapMedium"
                    android:selectAllOnFocus="true"
                    android:singleLine="true"
                    android:textColor="?attr/colorOnBackground"
                    android:textColorHint="?attr/colorOnBackground"
                    android:textSize="@dimen/textSizeSmall" />

                <androidx.appcompat.widget.AppCompatImageButton
                    android:id="@+id/ocr_inventorylist_a_refresh"
                    android:layout_width="@dimen/iconTouchSize"
                    android:layout_height="@dimen/iconTouchSize"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/ocr_inventory_refresh"
                    android:padding="12dp"
                    android:src="@drawable/ic_refresh_24"
                    app:tint="?attr/colorPrimary" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/ocr_inventorylist_a_summary_card"
            android:layout_width="0dp"
            android:layout_height="@dimen/controlHeight"
            android:layout_marginTop="@dimen/gapMedium"
            app:cardBackgroundColor="?attr/colorSurface"
            app:cardCornerRadius="@dimen/radiusLarge"
            app:cardElevation="@dimen/elevationSmall"
            app:strokeColor="?attr/colorPrimary"
            app:strokeWidth="1dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/ocr_inventorylist_a_search_card">

            <LinearLayout
                android:id="@+id/ocr_inventorylist_a_ll_counter_path"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/gapMedium"
                android:paddingEnd="@dimen/gapMedium">

                <TextView
                    android:id="@+id/ocr_inventorylist_a_count"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="0.42"
                    android:gravity="center"
                    android:maxLines="1"
                    android:textColor="?attr/colorPrimary"
                    android:textSize="@dimen/textSizeMedium"
                    android:textStyle="bold"
                    tools:text="@string/ocr_inventory_count_sample" />

                <View
                    android:layout_width="1dp"
                    android:layout_height="32dp"
                    android:alpha="0.25"
                    android:background="?attr/colorPrimary" />

                <Spinner
                    android:id="@+id/ocr_inventorylist_a_path"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="@dimen/gapMedium"
                    android:layout_weight="0.58"
                    android:background="@android:color/transparent"
                    android:contentDescription="@string/ocr_inventory_path"
                    android:gravity="center"
                    android:paddingStart="@dimen/gapMedium"
                    android:paddingEnd="@dimen/gapMedium"
                    android:popupBackground="?attr/colorSurface"
                    android:spinnerMode="dropdown" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/ocr_inventorylist_a_recyclerView"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/gapMedium"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:paddingTop="@dimen/gapSmall"
            android:paddingBottom="@dimen/gapXXLarge"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/ocr_inventorylist_a_summary_card"
            tools:listitem="@android:layout/simple_list_item_2" />

        <androidx.core.widget.ContentLoadingProgressBar
            android:id="@+id/ocr_inventorylist_a_prog"
            style="?android:attr/progressBarStyle"
            android:layout_width="@dimen/loading"
            android:layout_height="@dimen/loading"
            android:indeterminate="true"
            android:visibility="visible"
            app:layout_constraintBottom_toBottomOf="@id/ocr_inventorylist_a_recyclerView"
            app:layout_constraintEnd_toEndOf="@id/ocr_inventorylist_a_recyclerView"
            app:layout_constraintStart_toStartOf="@id/ocr_inventorylist_a_recyclerView"
            app:layout_constraintTop_toTopOf="@id/ocr_inventorylist_a_recyclerView" />

        <LinearLayout
            android:id="@+id/ocr_inventorylist_a_empty_container"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="@dimen/gapLarge"
            app:layout_constraintBottom_toBottomOf="@id/ocr_inventorylist_a_recyclerView"
            app:layout_constraintEnd_toEndOf="@id/ocr_inventorylist_a_recyclerView"
            app:layout_constraintStart_toStartOf="@id/ocr_inventorylist_a_recyclerView"
            app:layout_constraintTop_toTopOf="@id/ocr_inventorylist_a_recyclerView">

            <com.airbnb.lottie.LottieAnimationView
                android:id="@+id/ocr_inventorylist_a_lottie"
                android:layout_width="@dimen/emptyAnimationSize"
                android:layout_height="@dimen/emptyAnimationSize"
                android:visibility="gone"
                app:lottie_autoPlay="true"
                app:lottie_loop="true"
                app:lottie_rawRes="@raw/notfind" />

            <TextView
                android:id="@+id/ocr_inventorylist_a_tvstatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gapMedium"
                android:gravity="center"
                android:maxLines="3"
                android:paddingStart="@dimen/gapLarge"
                android:paddingEnd="@dimen/gapLarge"
                android:textColor="?attr/colorOnBackground"
                android:textSize="@dimen/textSizeMedium"
                android:textStyle="bold" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/ocr_inventorylist_a_fab"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="@dimen/fab_margin"
        android:contentDescription="@string/ocr_inventory_refresh"
        android:visibility="gone"
        app:backgroundTint="?attr/colorError"
        app:borderWidth="0dp"
        app:elevation="6dp"
        app:fabSize="normal"
        app:srcCompat="@drawable/ic_attach_file"
        app:tint="?attr/colorOnPrimary" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>