                        android:layout_height="36dp"
                        android:background="@drawable/bg_editbox"
                        android:gravity="center"
                        android:maxLines="1"
                        android:textColor="?attr/colorPrimary"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        tools:text="۴۰" />

