                    android:gravity="start|center_vertical"
                    android:paddingStart="5dp"
                    android:text="مجموع شمارش اول"
                    android:textColor="?attr/colorOnBackground"
                    android:textSize="9sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/ocr_stackenumeration_locationstack_listapi_c_firstnum"
                    android:layout_width="0dp"
                    android:layout_height="34dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_editbox"
                    android:gravity="center"
                    android:maxLines="1"
                    android:paddingStart="5dp"
                    android:paddingEnd="5dp"
                    android:textColor="?attr/colorPrimary"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    tools:text="۱۲۵" />

            </androidx.appcompat.widget.LinearLayoutCompat>

            <androidx.appcompat.widget.LinearLayoutCompat
                android:id="@+id/ocr_stackenumeration_locationstack_listapi_c_ll_first_auxn"
                android:layout_width="match_parent"
                android:layout_height="66dp"
                android:layout_marginBottom="4dp"
                android:gravity="center"
                android:orientation="horizontal"
                android:visibility="gone"
                tools:visibility="visible">

                <LinearLayout
                    android:id="@+id/ocr_stackenumeration_locationstack_listapi_c_ll_auxn11"
                    android:layout_width="0dp"
                    android:layout_height="60dp"
                    android:layout_marginEnd="2dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_round"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="3dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="18dp"
                        android:gravity="center"
                        android:text="شمارش ۱-۱"
                        android:textColor="?attr/colorOnBackground"
                        android:textSize="8sp"
                        android:textStyle="bold" />

                    <TextView
