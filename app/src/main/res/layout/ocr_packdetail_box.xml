<?xml version="1.0" encoding="utf-8"?>

<androidx.appcompat.widget.LinearLayoutCompat
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layoutDirection="rtl"
    android:orientation="vertical"
    android:paddingStart="4dp"
    android:paddingTop="3dp"
    android:paddingEnd="4dp"
    android:paddingBottom="3dp">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="?attr/colorSurface"
        app:cardCornerRadius="10dp"
        app:cardElevation="1dp"
        app:strokeColor="?attr/colorPrimary"
        app:strokeWidth="1dp">

        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layoutDirection="rtl"
            android:orientation="vertical"
            android:padding="6dp">

            <!-- Dynamic job information -->
            <androidx.appcompat.widget.LinearLayoutCompat
                android:id="@+id/ocr_packdetail_b_linejob"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layoutDirection="rtl"
                android:orientation="vertical"
                android:paddingBottom="3dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:alpha="0.14"
                android:background="?attr/colorOnBackground" />

            <!-- Explanation -->
            <androidx.appcompat.widget.LinearLayoutCompat
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="76dp"
                    android:layout_height="match_parent"
                    android:gravity="start|center_vertical"
                    android:paddingStart="5dp"
                    android:text="توضیحات"
                    android:textColor="?attr/colorOnBackground"
                    android:textSize="9sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/ocr_packdetail_b_ocrexplain"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_editbox"
                    android:gravity="start|center_vertical"
                    android:hint="توضیحات بسته‌بندی"
                    android:imeOptions="actionNext"
                    android:inputType="textCapSentences"
                    android:maxLines="1"
                    android:paddingStart="9dp"
                    android:paddingEnd="9dp"
                    android:selectAllOnFocus="true"
                    android:singleLine="true"
                    android:textColor="?attr/colorOnBackground"
                    android:textColorHint="?attr/colorOnBackground"
                    android:textSize="11sp"
                    tools:ignore="LabelFor" />

            </androidx.appcompat.widget.LinearLayoutCompat>

            <!-- Package amount -->
            <androidx.appcompat.widget.LinearLayoutCompat
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="76dp"
                    android:layout_height="match_parent"
                    android:gravity="start|center_vertical"
                    android:paddingStart="5dp"
                    android:text="تعداد بسته"
                    android:textColor="?attr/colorOnBackground"
                    android:textSize="9sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/ocr_packdetail_b_packamount"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_weight="1"
                    android:autofillHints=""
                    android:background="@drawable/bg_editbox"
                    android:digits="0123456789"
                    android:gravity="center"
                    android:hint="1"
                    android:imeOptions="actionDone"
                    android:inputType="number"
                    android:maxLength="5"
                    android:maxLines="1"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:selectAllOnFocus="true"
                    android:singleLine="true"
                    android:textColor="?attr/colorOnBackground"
                    android:textColorHint="?attr/colorOnBackground"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    tools:ignore="LabelFor"
                    tools:text="3" />

            </androidx.appcompat.widget.LinearLayoutCompat>

            <!-- Delivery date -->
            <androidx.appcompat.widget.LinearLayoutCompat
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="76dp"
                    android:layout_height="match_parent"
                    android:gravity="start|center_vertical"
                    android:paddingStart="5dp"
                    android:text="تاریخ تحویل"
                    android:textColor="?attr/colorOnBackground"
                    android:textSize="9sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/ocr_packdetail_b_senddate"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_editbox"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:maxLines="1"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:textColor="?attr/colorOnBackground"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    tools:text="۱۴۰۵/۰۵/۱۲" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/ocr_packdetail_b_btn5"
                    style="@style/Widget.MaterialComponents.Button"
                    android:layout_width="72dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="4dp"
                    android:backgroundTint="?attr/colorSurface"
                    android:gravity="center"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:text="تغییر"
                    android:textColor="?attr/colorPrimary"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    app:cornerRadius="8dp"
                    app:strokeColor="?attr/colorPrimary"
                    app:strokeWidth="1dp" />

            </androidx.appcompat.widget.LinearLayoutCompat>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="2dp"
                android:alpha="0.14"
                android:background="?attr/colorOnBackground" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/ocr_packdetail_b_send"
                style="@style/Widget.MaterialComponents.Button"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="6dp"
                android:backgroundTint="?attr/colorPrimary"
                android:gravity="center"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="ثبت و ارسال بسته‌بندی فاکتور"
                android:textColor="?attr/colorOnPrimary"
                android:textSize="11sp"
                android:textStyle="bold"
                app:cornerRadius="8dp" />

        </androidx.appcompat.widget.LinearLayoutCompat>

    </com.google.android.material.card.MaterialCardView>

</androidx.appcompat.widget.LinearLayoutCompat>