<?xml version="1.0" encoding="utf-8"?>

<androidx.appcompat.widget.LinearLayoutCompat
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/order_basketinfo_explain_box"
    android:layout_width="320dp"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:layoutDirection="rtl"
    android:orientation="vertical"
    android:padding="5dp">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="?attr/colorSurface"
        app:cardCornerRadius="10dp"
        app:cardElevation="2dp"
        app:strokeColor="?attr/colorPrimary"
        app:strokeWidth="1dp">

        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layoutDirection="rtl"
            android:orientation="vertical"
            android:padding="7dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:gravity="start|center_vertical"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:text="@string/goodorder_explain"
                android:textColor="?attr/colorPrimary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:alpha="0.15"
                android:background="?attr/colorOnBackground" />

            <!-- Explanation template -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="28dp"
                android:gravity="start|center_vertical"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:text="انتخاب متن آماده"
                android:textColor="?attr/colorOnBackground"
                android:textSize="9sp"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/ord_basketexplain_b_spinnerexplain"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:background="@drawable/bg_editbox"
                android:gravity="center"
                android:paddingStart="8dp"
                android:paddingEnd="8dp" />

            <!-- Custom explanation -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="30dp"
                android:layout_marginTop="3dp"
                android:gravity="start|center_vertical"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:text="متن توضیحات"
                android:textColor="?attr/colorOnBackground"
                android:textSize="9sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/ord_basketexplain_b_explain_tv"
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:autofillHints=""
                android:background="@drawable/bg_editbox"
                android:gravity="start|top"
                android:hint="@string/basketinfo_edexplain"
                android:imeOptions="actionDone"
                android:inputType="textCapSentences|textMultiLine"
                android:maxLines="4"
                android:minLines="3"
                android:paddingStart="9dp"
                android:paddingTop="8dp"
                android:paddingEnd="9dp"
                android:paddingBottom="8dp"
                android:textColor="?attr/colorOnBackground"
                android:textColorHint="@color/secondaryTextColor"
                android:textSize="11sp"
                tools:ignore="LabelFor" />

            <Button
                android:id="@+id/ord_basketexplain_b_explain_btn"
                style="@style/Widget.MaterialComponents.Button"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="7dp"
                android:backgroundTint="?attr/colorPrimary"
                android:gravity="center"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="@string/basketinfo_setexplain"
                android:textColor="?attr/colorOnPrimary"
                android:textSize="11sp"
                android:textStyle="bold" />

        </androidx.appcompat.widget.LinearLayoutCompat>

    </com.google.android.material.card.MaterialCardView>

</androidx.appcompat.widget.LinearLayoutCompat>