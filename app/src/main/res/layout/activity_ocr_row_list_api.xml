<?xml version="1.0" encoding="utf-8"?>

<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="rtl"
    android:background="?attr/colorSurface"
    tools:context=".activity.ocr.Ocr_StackEnumeration_Good_List_Api_Activity">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/ocr_rowlist_a_appbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorPrimary"
        app:elevation="4dp">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/ocr_rowlist_a_toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="?attr/colorPrimary"
            app:title="انتخاب کالا"
            app:titleTextColor="?attr/colorOnPrimary">

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/ocr_rowlist_a_switch_active"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end|center_vertical"
                android:layout_marginEnd="8dp"
                android:checked="true"
                android:text="@string/active_activeswitch"
                android:textColor="?attr/colorOnPrimary"
                android:textSize="13sp"
                app:buttonTint="?attr/colorOnPrimary"
                app:thumbTint="?attr/colorOnPrimary"
                app:trackTint="?attr/colorSecondary" />

        </androidx.appcompat.widget.Toolbar>

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingStart="@dimen/gapLarge"
        android:paddingTop="@dimen/gapMedium"
        android:paddingEnd="@dimen/gapLarge"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/ocr_rowlist_a_show_locationstack"
            style="@style/Widget.MaterialComponents.Button"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:text="نمایش شمارش‌ها"
            android:textColor="?attr/colorOnSecondary"
            android:textSize="15sp"
            android:textStyle="bold"
            app:backgroundTint="?attr/colorSecondary"
            app:cornerRadius="14dp"
            app:icon="@drawable/ic_search_product"
            app:iconGravity="textStart"
            app:iconPadding="@dimen/gapMedium"
            app:iconSize="22dp"
            app:iconTint="?attr/colorOnSecondary"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:strokeColor="?attr/colorPrimary"
            app:strokeWidth="1dp" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/ocr_rowlist_a_search_card"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_marginTop="@dimen/gapMedium"
            app:cardBackgroundColor="?attr/colorSurface"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/ocr_rowlist_a_show_locationstack"
            app:strokeColor="?attr/colorPrimary"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/gapLarge"
                android:paddingEnd="@dimen/gapSmall">

                <androidx.appcompat.widget.AppCompatEditText
                    android:id="@+id/ocr_rowlist_a_edtsearch"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:gravity="start|center_vertical"
                    android:hint="جستجوی کالا"
                    android:imeOptions="actionSearch"
                    android:inputType="text"
                    android:maxLines="1"
                    android:paddingStart="0dp"
                    android:paddingEnd="@dimen/gapMedium"
                    android:selectAllOnFocus="true"
                    android:singleLine="true"
                    android:textColor="?attr/colorOnBackground"
                    android:textColorHint="?attr/colorOnBackground"
                    android:textSize="@dimen/textSizeSmall" />

                <Button
                    android:id="@+id/ocr_rowlist_a_refresh"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/ic_refresh_24"
                    android:contentDescription="به‌روزرسانی"
                    android:gravity="center"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:padding="12dp"
                    android:text=""
                    android:textColor="?attr/colorPrimary" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <FrameLayout
            android:id="@+id/ocr_rowlist_a_list_container"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/gapMedium"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/ocr_rowlist_a_search_card">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/ocr_rowlist_a_recyclerView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:overScrollMode="never"
                android:paddingTop="@dimen/gapSmall"
                android:paddingBottom="88dp"
                tools:listitem="@android:layout/simple_list_item_2" />

            <androidx.core.widget.ContentLoadingProgressBar
                android:id="@+id/ocr_rowlist_a_prog"
                style="?android:attr/progressBarStyle"
                android:layout_width="@dimen/loading"
                android:layout_height="@dimen/loading"
                android:layout_gravity="center"
                android:indeterminate="true"
                android:visibility="visible" />

            <LinearLayout
                android:id="@+id/ocr_rowlist_a_empty_container"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="@dimen/gapLarge">

                <com.airbnb.lottie.LottieAnimationView
                    android:id="@+id/ocr_rowlist_a_lottie"
                    android:layout_width="180dp"
                    android:layout_height="180dp"
                    android:visibility="gone"
                    app:lottie_autoPlay="true"
                    app:lottie_loop="true"
                    app:lottie_rawRes="@raw/notfind" />

                <TextView
                    android:id="@+id/ocr_rowlist_a_tvstatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/gapMedium"
                    android:gravity="center"
                    android:maxLines="3"
                    android:paddingStart="@dimen/gapLarge"
                    android:paddingEnd="@dimen/gapLarge"
                    android:textColor="?attr/colorOnBackground"
                    android:textSize="@dimen/textSizeMedium"
                    android:textStyle="bold"
                    tools:text="کالایی پیدا نشد" />

            </LinearLayout>

        </FrameLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/ocr_rowlist_a_fab"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="@dimen/fab_margin"
        android:contentDescription="پیوست"
        android:visibility="gone"
        app:backgroundTint="?attr/colorSecondary"
        app:borderWidth="0dp"
        app:elevation="6dp"
        app:fabSize="normal"
        app:srcCompat="@drawable/ic_attach_file"
        app:tint="?attr/colorOnSecondary" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>