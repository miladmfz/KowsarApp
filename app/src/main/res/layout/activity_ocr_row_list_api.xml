<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:layoutDirection="rtl"
    tools:context=".activity.ocr.Ocr_StackEnumeration_Good_List_Api_Activity">

    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/ocr_rowlist_a_appbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            >

            <androidx.appcompat.widget.Toolbar
                android:id="@+id/ocr_rowlist_a_toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                android:background="?attr/colorPrimary"
                app:titleTextColor="?attr/colorOnPrimary"
                app:title="انتخاب فاکتور"

                >


                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/ocr_rowlist_a_switch_active"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="50dp"
                    android:checked="true"
                    android:text="@string/active_activeswitch"
                    android:textColor="@color/white"

                    />
            </androidx.appcompat.widget.Toolbar>






        </com.google.android.material.appbar.AppBarLayout>

        <com.google.android.material.button.MaterialButton

            android:id="@+id/ocr_rowlist_a_show_locationstack"
            android:layout_width="match_parent"
            android:layout_height="50sp"
            android:text="نمایش شمارش ها"
            app:iconTint="?attr/colorPrimary"

            app:strokeColor="?attr/colorPrimary"
            app:strokeWidth="2dp"
            app:icon="@drawable/ic_search_product"
            app:cornerRadius="8dp"
            app:iconGravity="start"
            app:iconSize="24dp"
            android:layout_margin="2dp"
            android:textSize="16sp"
            android:textStyle="bold"
            style="@style/Widget.MaterialComponents.Button"
            android:backgroundTint="?attr/colorSecondary"
            android:textColor="?attr/colorOnSecondary"
            />



        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:orientation="horizontal"
            android:weightSum="1">

            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/ocr_rowlist_a_edtsearch"
                android:layout_margin="2dp"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:hint="جستجو"
                android:background="@drawable/bg_editbox"
                android:singleLine="true"
                android:selectAllOnFocus="true"
                android:inputType="text"
                android:textColor="?attr/colorOnBackground"
                android:layout_weight="0.1"
                />

            <Button
                android:id="@+id/ocr_rowlist_a_refresh"

                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:textSize="26sp"
                android:gravity="center"
                android:layout_weight="0.9"

                android:background="@drawable/ic_refresh_24"
                android:textColor="?attr/colorOnBackground"
                />


        </LinearLayout>




        <androidx.core.widget.ContentLoadingProgressBar
            android:id="@+id/ocr_rowlist_a_prog"
            style="?android:attr/progressBarStyle"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="5dp"
            android:layout_centerHorizontal="true"
            android:layout_centerVertical="true"
            android:indeterminate="true"
            android:layout_weight="0.9"
            android:visibility="visible"
            />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/ocr_rowlist_a_recyclerView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingBottom="80dp"
            android:layout_margin="2dp" />



        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/ocr_rowlist_a_lottie"
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:layout_margin="2dp"
            app:lottie_rawRes="@raw/notfind"
            app:lottie_autoPlay="true"
            app:lottie_loop="true"
            android:visibility="gone"
            android:layout_gravity="center"
            />


        <TextView
            android:id="@+id/ocr_rowlist_a_tvstatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="40sp"
            android:layout_gravity="center"
            android:textColor="?attr/colorOnBackground"

            />

    </androidx.appcompat.widget.LinearLayoutCompat>
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/ocr_rowlist_a_fab"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end|bottom"
        android:layout_margin="30dp"
        android:visibility="gone"
        app:backgroundTint="@color/red_800"
        app:borderWidth="0dp"
        app:elevation="6dp"
        app:fabSize="normal"
        android:src="@drawable/ic_attach_file" />

</androidx.appcompat.widget.LinearLayoutCompat>