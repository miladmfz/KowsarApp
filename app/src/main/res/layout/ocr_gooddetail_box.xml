<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/ocr_gooddetail_box"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layoutDirection="rtl"
    android:orientation="vertical"
    android:padding="8dp">

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="6dp"
        app:cardBackgroundColor="?attr/colorSurface"
        app:cardCornerRadius="20dp"
        app:cardElevation="10dp"
        app:cardUseCompatPadding="true">

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fillViewport="true"
            android:overScrollMode="ifContentScrolls"
            android:scrollbars="vertical">

            <androidx.appcompat.widget.LinearLayoutCompat
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="14dp"
                android:paddingTop="14dp"
                android:paddingEnd="14dp"
                android:paddingBottom="14dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="جزئیات کالا"
                    android:textColor="?attr/colorPrimary"
                    android:textSize="19sp"
                    android:textStyle="bold"
                    android:paddingBottom="10dp"/>

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="220dp"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/bg_ocr_detail_image"
                    android:padding="8dp">

                    <ImageView
                        android:id="@+id/ocr_gooddetail_b_img"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_gravity="center"
                        android:adjustViewBounds="true"
                        android:contentDescription="تصویر کالا"
                        android:scaleType="centerInside"/>
                </FrameLayout>

                <androidx.appcompat.widget.LinearLayoutCompat
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal"
                    android:weightSum="2">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/ocr_gooddetail_b_btn_confirm"
                        style="@style/Widget.MaterialComponents.Button"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_marginEnd="4dp"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="تایید کالا"
                        android:textAllCaps="false"
                        android:textColor="?attr/colorOnPrimary"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        app:backgroundTint="?attr/colorPrimary"
                        app:cornerRadius="12dp"
                        app:iconGravity="textStart"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/ocr_gooddetail_b_btn_cancel"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_marginStart="4dp"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="لغو"
                        android:textAllCaps="false"
                        android:textColor="@color/red_700"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        app:cornerRadius="12dp"
                        app:strokeColor="@color/red_300"
                        app:strokeWidth="1dp"/>
                </androidx.appcompat.widget.LinearLayoutCompat>

                <androidx.appcompat.widget.LinearLayoutCompat
                    android:id="@+id/ocr_gooddetail_ll_lb1"
                    style="@style/OcrDetailRow">

                    <TextView
                        android:id="@+id/ocr_gooddetail_b_lb1"
                        style="@style/OcrDetailLabel"
                        android:text="موجودی کل"/>

                    <TextView
                        android:id="@+id/ocr_gooddetail_b_tv1"
                        style="@style/OcrDetailValue"/>
                </androidx.appcompat.widget.LinearLayoutCompat>

                <androidx.appcompat.widget.LinearLayoutCompat
                    android:id="@+id/ocr_gooddetail_ll_lb2"
                    style="@style/OcrDetailRow">

                    <TextView
                        android:id="@+id/ocr_gooddetail_b_lb2"
                        style="@style/OcrDetailLabel"
                        android:text="قطع"/>

                    <TextView
                        android:id="@+id/ocr_gooddetail_b_tv2"
                        style="@style/OcrDetailValue"/>
                </androidx.appcompat.widget.LinearLayoutCompat>

                <androidx.appcompat.widget.LinearLayoutCompat
                    android:id="@+id/ocr_gooddetail_ll_lb3"
                    style="@style/OcrDetailRow">

                    <TextView
                        android:id="@+id/ocr_gooddetail_b_lb3"
                        style="@style/OcrDetailLabel"
                        android:text="نوع جلد"/>

                    <TextView
                        android:id="@+id/ocr_gooddetail_b_tv3"
                        style="@style/OcrDetailValue"/>
                </androidx.appcompat.widget.LinearLayoutCompat>

                <androidx.appcompat.widget.LinearLayoutCompat
                    android:id="@+id/ocr_gooddetail_ll_lb4"
                    style="@style/OcrDetailRow">

                    <TextView
                        android:id="@+id/ocr_gooddetail_b_lb4"
                        style="@style/OcrDetailLabel"
                        android:text="پشت جلد"/>

                    <TextView
                        android:id="@+id/ocr_gooddetail_b_tv4"
                        style="@style/OcrDetailValue"/>
                </androidx.appcompat.widget.LinearLayoutCompat>

                <androidx.appcompat.widget.LinearLayoutCompat
                    android:id="@+id/ocr_gooddetail_ll_lb5"
                    style="@style/OcrDetailRow">

                    <TextView
                        android:id="@+id/ocr_gooddetail_b_lb5"
                        style="@style/OcrDetailLabel"
                        android:text="شماره قفسه"/>

                    <TextView
                        android:id="@+id/ocr_gooddetail_b_tv5"
                        style="@style/OcrDetailValue"/>
                </androidx.appcompat.widget.LinearLayoutCompat>

                <androidx.appcompat.widget.LinearLayoutCompat
                    android:id="@+id/ocr_gooddetail_ll_lb6"
                    style="@style/OcrDetailRow">

                    <TextView
                        android:id="@+id/ocr_gooddetail_b_lb6"
                        style="@style/OcrDetailLabel"
                        android:text="شماره قفسه"/>

                    <TextView
                        android:id="@+id/ocr_gooddetail_b_tv6"
                        style="@style/OcrDetailValue"/>
                </androidx.appcompat.widget.LinearLayoutCompat>

                <androidx.appcompat.widget.LinearLayoutCompat
                    android:id="@+id/ocr_gooddetail_ll_lb7"
                    style="@style/OcrDetailRow">

                    <TextView
                        android:id="@+id/ocr_gooddetail_b_lb7"
                        style="@style/OcrDetailLabel"
                        android:text="کد کالا"/>

                    <TextView
                        android:id="@+id/ocr_gooddetail_b_tv7"
                        style="@style/OcrDetailValue"/>
                </androidx.appcompat.widget.LinearLayoutCompat>

            </androidx.appcompat.widget.LinearLayoutCompat>
        </androidx.core.widget.NestedScrollView>
    </androidx.cardview.widget.CardView>

</androidx.appcompat.widget.LinearLayoutCompat>
