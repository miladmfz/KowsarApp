<?xml version="1.0" encoding="utf-8"?>

<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layoutDirection="rtl"
    android:layout_marginStart="3dp"
    android:layout_marginTop="2dp"
    android:layout_marginEnd="3dp"
    android:layout_marginBottom="2dp"
    app:cardBackgroundColor="?attr/colorSurface"
    app:cardCornerRadius="10dp"
    app:cardElevation="1dp"
    app:strokeColor="?attr/colorPrimary"
    app:strokeWidth="1dp">

    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/ord_grp_c_list"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        android:orientation="vertical"
        android:padding="5dp">

        <ImageView
            android:id="@+id/ord_grp_c_image"
            android:layout_width="match_parent"
            android:layout_height="90dp"
            android:contentDescription="تصویر گروه کالا"
            android:padding="4dp"
            android:scaleType="centerInside"
            android:visibility="gone"
            tools:src="@drawable/img_base_no_photo"
            tools:visibility="gone" />

        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/ord_grp_c_name"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:ellipsize="end"
                android:gravity="start|center_vertical"
                android:maxLines="2"
                android:paddingStart="7dp"
                android:paddingEnd="5dp"
                android:text="@string/grplist_name"
                android:textColor="?attr/colorOnBackground"
                android:textSize="11sp"
                android:textStyle="bold"
                tools:text="گروه کالا" />

            <ImageView
                android:id="@+id/ord_grp_c_imgv"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="@drawable/ic_arrow_down"
                android:contentDescription="نمایش زیرگروه‌ها"
                android:padding="7dp"
                android:scaleType="centerInside" />

        </androidx.appcompat.widget.LinearLayoutCompat>

        <View
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:layout_marginTop="2dp"
            android:background="?attr/colorPrimary" />

    </androidx.appcompat.widget.LinearLayoutCompat>

</com.google.android.material.card.MaterialCardView>