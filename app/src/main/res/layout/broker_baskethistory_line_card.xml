<?xml version="1.0" encoding="utf-8"?>

<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/broker_baskethistory_card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layoutDirection="rtl"
    android:layout_marginStart="3dp"
    android:layout_marginTop="2dp"
    android:layout_marginEnd="3dp"
    android:layout_marginBottom="2dp"
    app:cardBackgroundColor="?attr/colorSurface"
    app:cardCornerRadius="9dp"
    app:cardElevation="1dp"
    app:strokeColor="?attr/colorPrimary"
    app:strokeWidth="1dp"
    tools:ignore="MissingDefaultResource">

    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="5dp">

        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="72dp"
                android:layout_height="match_parent"
                android:gravity="start|center_vertical"
                android:maxLines="1"
                android:text="@string/detail_goodname"
                android:textColor="?attr/colorOnBackground"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/b_baskethistory_c_name"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:ellipsize="end"
                android:gravity="start|center_vertical"
                android:maxLines="2"
                android:paddingStart="5dp"
                android:paddingEnd="5dp"
                android:text="@string/detail_goodname"
                android:textColor="?attr/colorOnBackground"
                android:textSize="13sp"
                android:textStyle="bold"
                tools:text="نام کامل کالا و مشخصات محصول" />

        </androidx.appcompat.widget.LinearLayoutCompat>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:alpha="0.14"
            android:background="?attr/colorOnBackground" />

        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <androidx.appcompat.widget.LinearLayoutCompat
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="0.75"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:maxLines="1"
                    android:text="@string/amount"
                    android:textColor="?attr/colorOnBackground"
                    android:textSize="9sp" />

                <TextView
                    android:id="@+id/b_baskethistory_c_amount"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:maxLines="1"
                    android:text="@string/amount"
                    android:textColor="?attr/colorPrimary"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    tools:text="۲" />

            </androidx.appcompat.widget.LinearLayoutCompat>

            <View
                android:layout_width="1dp"
                android:layout_height="28dp"
                android:alpha="0.14"
                android:background="?attr/colorOnBackground" />

            <androidx.appcompat.widget.LinearLayoutCompat
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:maxLines="1"
                    android:text="@string/deatil_goodcode"
                    android:textColor="?attr/colorOnBackground"
                    android:textSize="9sp" />

                <TextView
                    android:id="@+id/b_baskethistory_c_code"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:maxLines="1"
                    android:text="@string/deatil_goodcode"
                    android:textColor="?attr/colorPrimary"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    tools:text="۱۲۵۴۸" />

            </androidx.appcompat.widget.LinearLayoutCompat>

            <View
                android:layout_width="1dp"
                android:layout_height="28dp"
                android:alpha="0.14"
                android:background="?attr/colorOnBackground" />

            <androidx.appcompat.widget.LinearLayoutCompat
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.25"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:maxLines="1"
                    android:text="@string/boxbuy_total"
                    android:textColor="?attr/colorOnBackground"
                    android:textSize="9sp" />

                <TextView
                    android:id="@+id/b_baskethistory_c_total"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:maxLines="1"
                    android:text="@string/boxbuy_total"
                    android:textColor="?attr/colorPrimary"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    tools:text="۲۵۰,۰۰۰" />

            </androidx.appcompat.widget.LinearLayoutCompat>

        </androidx.appcompat.widget.LinearLayoutCompat>

        <ImageView
            android:id="@+id/b_baskethistory_c_img"
            android:layout_width="1dp"
            android:layout_height="1dp"
            android:contentDescription="تصویر کالا"
            android:visibility="gone" />

        <TextView
            android:id="@+id/b_baskethistory_c_price"
            android:layout_width="1dp"
            android:layout_height="1dp"
            android:text="@string/boxbuy_total"
            android:textColor="?attr/colorOnBackground"
            android:visibility="gone" />

    </androidx.appcompat.widget.LinearLayoutCompat>

</com.google.android.material.card.MaterialCardView>