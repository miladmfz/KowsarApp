<?xml version="1.0" encoding="utf-8"?>

<androidx.appcompat.widget.LinearLayoutCompat
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/ocr_goodinventory_box"
    android:layout_width="340dp"
    android:layout_height="560dp"
    android:layout_gravity="center"
    android:layoutDirection="rtl"
    android:orientation="vertical"
    android:padding="5dp">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:cardBackgroundColor="?attr/colorSurface"
        app:cardCornerRadius="10dp"
        app:cardElevation="3dp"
        app:strokeColor="?attr/colorPrimary"
        app:strokeWidth="1dp">

        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <!-- Header -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="?attr/colorPrimary"
                android:gravity="start|center_vertical"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="شمارش موجودی کالا"
                android:textColor="?attr/colorOnPrimary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <androidx.core.widget.NestedScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:fillViewport="true"
                android:overScrollMode="never">

                <androidx.appcompat.widget.LinearLayoutCompat
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="7dp">

                    <!-- Product image -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="180dp"
                        app:cardBackgroundColor="@color/white"
                        app:cardCornerRadius="8dp"
                        app:cardElevation="0dp"
                        app:strokeColor="?attr/colorPrimary"
                        app:strokeWidth="1dp">

                        <ImageView
                            android:id="@+id/ocr_goodinventory_b_img"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:contentDescription="تصویر کالا"
                            android:padding="4dp"
                            android:scaleType="centerInside"
                            tools:src="@drawable/ic_launcher_foreground" />

                    </com.google.android.material.card.MaterialCardView>

                    <!-- Count input -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="58dp"
                        android:layout_marginTop="6dp"
                        app:cardBackgroundColor="?attr/colorSurface"
                        app:cardCornerRadius="8dp"
                        app:cardElevation="0dp"
                        app:strokeColor="?attr/colorPrimary"
                        app:strokeWidth="1dp">

                        <androidx.appcompat.widget.LinearLayoutCompat
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:padding="5dp">

                            <TextView
                                android:id="@+id/ocr_goodinventory_b_tvcount"
                                android:layout_width="104dp"
                                android:layout_height="match_parent"
                                android:gravity="start|center_vertical"
                                android:paddingStart="5dp"
                                android:text="تعداد شمارش"
                                android:textColor="?attr/colorOnBackground"
                                android:textSize="10sp"
                                android:textStyle="bold" />

                            <EditText
                                android:id="@+id/ocr_goodinventory_b_ed1"
                                android:layout_width="0dp"
                                android:layout_height="44dp"
                                android:layout_weight="1"
                                android:autofillHints=""
                                android:background="@drawable/bg_editbox"
                                android:digits="0123456789."
                                android:gravity="center"
                                android:hint="تعداد"
                                android:imeOptions="actionDone"
                                android:inputType="numberDecimal"
                                android:maxLines="1"
                                android:paddingStart="8dp"
                                android:paddingEnd="8dp"
                                android:selectAllOnFocus="true"
                                android:singleLine="true"
                                android:textColor="?attr/colorOnBackground"
                                android:textColorHint="?attr/colorOnBackground"
                                android:textSize="15sp"
                                android:textStyle="bold"
                                tools:ignore="LabelFor"
                                tools:text="25" />

                        </androidx.appcompat.widget.LinearLayoutCompat>

                    </com.google.android.material.card.MaterialCardView>

                    <!-- Additional information title -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="32dp"
                        android:layout_marginTop="4dp"
                        android:gravity="start|center_vertical"
                        android:paddingStart="5dp"
                        android:text="مشخصات کالا"
                        android:textColor="?attr/colorPrimary"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <!-- Label 2 -->
                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:id="@+id/ocr_goodinventory_ll_lb2"
                        android:layout_width="match_parent"
                        android:layout_height="42dp"
                        android:layout_marginBottom="3dp"
                        android:background="@drawable/bg_round"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="5dp"
                        android:paddingEnd="5dp">

                        <TextView
                            android:id="@+id/ocr_goodinventory_b_lb2"
                            android:layout_width="90dp"
                            android:layout_height="match_parent"
                            android:gravity="start|center_vertical"
                            android:paddingStart="5dp"
                            android:text="عنوان دوم"
                            android:textColor="?attr/colorOnBackground"
                            android:textSize="9sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/ocr_goodinventory_b_tv2"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:gravity="start|center_vertical"
                            android:maxLines="1"
                            android:paddingStart="6dp"
                            android:paddingEnd="6dp"
                            android:textColor="?attr/colorOnBackground"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            tools:text="مقدار مشخصات دوم" />

                    </androidx.appcompat.widget.LinearLayoutCompat>

                    <!-- Label 3 -->
                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:id="@+id/ocr_goodinventory_ll_lb3"
                        android:layout_width="match_parent"
                        android:layout_height="42dp"
                        android:layout_marginBottom="3dp"
                        android:background="@drawable/bg_round"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="5dp"
                        android:paddingEnd="5dp">

                        <TextView
                            android:id="@+id/ocr_goodinventory_b_lb3"
                            android:layout_width="90dp"
                            android:layout_height="match_parent"
                            android:gravity="start|center_vertical"
                            android:paddingStart="5dp"
                            android:text="عنوان سوم"
                            android:textColor="?attr/colorOnBackground"
                            android:textSize="9sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/ocr_goodinventory_b_tv3"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:gravity="start|center_vertical"
                            android:maxLines="1"
                            android:paddingStart="6dp"
                            android:paddingEnd="6dp"
                            android:textColor="?attr/colorOnBackground"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            tools:text="مقدار مشخصات سوم" />

                    </androidx.appcompat.widget.LinearLayoutCompat>

                    <!-- Label 1 -->
                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:id="@+id/ocr_goodinventory_ll_lb1"
                        android:layout_width="match_parent"
                        android:layout_height="42dp"
                        android:layout_marginBottom="3dp"
                        android:background="@drawable/bg_round"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="5dp"
                        android:paddingEnd="5dp">

                        <TextView
                            android:id="@+id/ocr_goodinventory_b_lb1"
                            android:layout_width="90dp"
                            android:layout_height="match_parent"
                            android:gravity="start|center_vertical"
                            android:paddingStart="5dp"
                            android:text="عنوان اول"
                            android:textColor="?attr/colorOnBackground"
                            android:textSize="9sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/ocr_goodinventory_b_tv1"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:gravity="start|center_vertical"
                            android:maxLines="1"
                            android:paddingStart="6dp"
                            android:paddingEnd="6dp"
                            android:textColor="?attr/colorOnBackground"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            tools:text="مقدار مشخصات اول" />

                    </androidx.appcompat.widget.LinearLayoutCompat>

                    <!-- Label 4 -->
                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:id="@+id/ocr_goodinventory_ll_lb4"
                        android:layout_width="match_parent"
                        android:layout_height="42dp"
                        android:layout_marginBottom="3dp"
                        android:background="@drawable/bg_round"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="5dp"
                        android:paddingEnd="5dp">

                        <TextView
                            android:id="@+id/ocr_goodinventory_b_lb4"
                            android:layout_width="90dp"
                            android:layout_height="match_parent"
                            android:gravity="start|center_vertical"
                            android:paddingStart="5dp"
                            android:text="عنوان چهارم"
                            android:textColor="?attr/colorOnBackground"
                            android:textSize="9sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/ocr_goodinventory_b_tv4"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:gravity="start|center_vertical"
                            android:maxLines="1"
                            android:paddingStart="6dp"
                            android:paddingEnd="6dp"
                            android:textColor="?attr/colorOnBackground"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            tools:text="مقدار مشخصات چهارم" />

                    </androidx.appcompat.widget.LinearLayoutCompat>

                </androidx.appcompat.widget.LinearLayoutCompat>

            </androidx.core.widget.NestedScrollView>

            <!-- Actions -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:alpha="0.15"
                android:background="?attr/colorOnBackground" />

            <androidx.appcompat.widget.LinearLayoutCompat
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:gravity="center"
                android:orientation="horizontal"
                android:padding="5dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/ocr_goodinventory_b_btn_confirm"
                    style="@style/Widget.MaterialComponents.Button"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginEnd="2dp"
                    android:layout_weight="1"
                    android:backgroundTint="?attr/colorPrimary"
                    android:gravity="center"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:text="ثبت و ارسال"
                    android:textColor="?attr/colorOnPrimary"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    app:cornerRadius="8dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/ocr_goodinventory_b_btn_cancel"
                    style="@style/Widget.MaterialComponents.Button"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="2dp"
                    android:layout_weight="1"
                    android:backgroundTint="@color/red_800"
                    android:gravity="center"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:text="لغو"
                    android:textColor="@color/white"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    app:cornerRadius="8dp" />

            </androidx.appcompat.widget.LinearLayoutCompat>

        </androidx.appcompat.widget.LinearLayoutCompat>

    </com.google.android.material.card.MaterialCardView>

</androidx.appcompat.widget.LinearLayoutCompat>