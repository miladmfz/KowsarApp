<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/order_reserve_box"
    android:layout_width="340dp"
    android:layout_height="580dp"
    android:layout_gravity="center"
    android:layoutDirection="rtl"
    android:orientation="vertical"
    android:padding="5dp">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:cardBackgroundColor="?attr/colorSurface"
        app:cardCornerRadius="10dp"
        app:cardElevation="3dp"
        app:strokeColor="?attr/colorPrimary"
        app:strokeWidth="1dp">

        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <!-- Header -->
            <TextView
                android:id="@+id/ord_reserve_b_rstmiz"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="?attr/colorPrimary"
                android:ellipsize="end"
                android:gravity="start|center_vertical"
                android:maxLines="1"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:textColor="?attr/colorOnPrimary"
                android:textSize="13sp"
                android:textStyle="bold"
                tools:text="رزرو میز شماره ۱۲" />

            <!-- Reservation form -->
            <androidx.appcompat.widget.LinearLayoutCompat
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="7dp"
                android:paddingTop="5dp"
                android:paddingEnd="7dp">

                <!-- Person name -->
                <androidx.appcompat.widget.LinearLayoutCompat
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="86dp"
                        android:layout_height="match_parent"
                        android:gravity="start|center_vertical"
                        android:paddingStart="5dp"
                        android:text="@string/reservebox_name"
                        android:textColor="?attr/colorOnBackground"
                        android:textSize="9sp"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/ord_reserve_b_personname"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:autofillHints="name"
                        android:background="@drawable/bg_editbox"
                        android:gravity="start|center_vertical"
                        android:hint="@string/reservebox_name"
                        android:imeOptions="actionNext"
                        android:inputType="textPersonName"
                        android:maxLines="1"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:singleLine="true"
                        android:textColor="?attr/colorOnBackground"
                        android:textColorHint="?attr/colorOnBackground"
                        android:textSize="11sp"
                        tools:ignore="LabelFor"
                        tools:text="میلاد فلاح" />

                </androidx.appcompat.widget.LinearLayoutCompat>

                <!-- Mobile -->
                <androidx.appcompat.widget.LinearLayoutCompat
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="86dp"
                        android:layout_height="match_parent"
                        android:gravity="start|center_vertical"
                        android:paddingStart="5dp"
                        android:text="@string/reservebox_mobile"
                        android:textColor="?attr/colorOnBackground"
                        android:textSize="9sp"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/ord_reserve_b_mobileno"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:autofillHints="phone"
                        android:background="@drawable/bg_editbox"
                        android:digits="0123456789"
                        android:gravity="center"
                        android:hint="@string/reservebox_mobile"
                        android:imeOptions="actionNext"
                        android:inputType="phone"
                        android:maxLength="11"
                        android:maxLines="1"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:singleLine="true"
                        android:textColor="?attr/colorOnBackground"
                        android:textColorHint="?attr/colorOnBackground"
                        android:textSize="11sp"
                        tools:ignore="LabelFor"
                        tools:text="09121234567" />

                </androidx.appcompat.widget.LinearLayoutCompat>

                <!-- Explanation -->
                <androidx.appcompat.widget.LinearLayoutCompat
                    android:layout_width="match_parent"
                    android:layout_height="68dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="86dp"
                        android:layout_height="match_parent"
                        android:gravity="start|center_vertical"
                        android:paddingStart="5dp"
                        android:text="@string/reservebox_explain"
                        android:textColor="?attr/colorOnBackground"
                        android:textSize="9sp"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/ord_reserve_b_explain"
                        android:layout_width="0dp"
                        android:layout_height="60dp"
                        android:layout_weight="1"
                        android:autofillHints=""
                        android:background="@drawable/bg_editbox"
                        android:gravity="start|top"
                        android:hint="@string/reservebox_explain"
                        android:imeOptions="actionDone"
                        android:inputType="textCapSentences|textMultiLine"
                        android:maxLines="3"
                        android:paddingStart="8dp"
                        android:paddingTop="7dp"
                        android:paddingEnd="8dp"
                        android:paddingBottom="7dp"
                        android:textColor="?attr/colorOnBackground"
                        android:textColorHint="?attr/colorOnBackground"
                        android:textSize="10sp"
                        tools:ignore="LabelFor"
                        tools:text="میز کنار پنجره باشد" />

                </androidx.appcompat.widget.LinearLayoutCompat>

                <!-- Start time -->
                <androidx.appcompat.widget.LinearLayoutCompat
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="86dp"
                        android:layout_height="match_parent"
                        android:gravity="start|center_vertical"
                        android:paddingStart="5dp"
                        android:text="@string/reservebox_starttime"
                        android:textColor="?attr/colorOnBackground"
                        android:textSize="9sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/ord_reserve_b_reservestart"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_editbox"
                        android:clickable="true"
                        android:ellipsize="end"
                        android:focusable="true"
                        android:gravity="center"
                        android:hint="@string/reservebox_starttime"
                        android:maxLines="1"
                        android:paddingStart="7dp"
                        android:paddingEnd="7dp"
                        android:textColor="?attr/colorPrimary"
                        android:textColorHint="?attr/colorOnBackground"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        tools:text="۲۰:۰۰" />

                </androidx.appcompat.widget.LinearLayoutCompat>

                <!-- End time -->
                <androidx.appcompat.widget.LinearLayoutCompat
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="86dp"
                        android:layout_height="match_parent"
                        android:gravity="start|center_vertical"
                        android:paddingStart="5dp"
                        android:text="@string/reservebox_endtime"
                        android:textColor="?attr/colorOnBackground"
                        android:textSize="9sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/ord_reserve_b_reserveend"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_editbox"
                        android:clickable="true"
                        android:ellipsize="end"
                        android:focusable="true"
                        android:gravity="center"
                        android:hint="@string/reservebox_endtime"
                        android:maxLines="1"
                        android:paddingStart="7dp"
                        android:paddingEnd="7dp"
                        android:textColor="?attr/colorPrimary"
                        android:textColorHint="?attr/colorOnBackground"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        tools:text="۲۲:۰۰" />

                </androidx.appcompat.widget.LinearLayoutCompat>

                <!-- Date -->
                <androidx.appcompat.widget.LinearLayoutCompat
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="86dp"
                        android:layout_height="match_parent"
                        android:gravity="start|center_vertical"
                        android:paddingStart="5dp"
                        android:text="@string/reservebox_date"
                        android:textColor="?attr/colorOnBackground"
                        android:textSize="9sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/ord_reserve_b_date"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_editbox"
                        android:clickable="true"
                        android:ellipsize="end"
                        android:focusable="true"
                        android:gravity="center"
                        android:hint="@string/reservebox_date"
                        android:maxLines="1"
                        android:paddingStart="7dp"
                        android:paddingEnd="7dp"
                        android:textColor="?attr/colorPrimary"
                        android:textColorHint="?attr/colorOnBackground"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        tools:text="۱۴۰۵/۰۵/۱۴" />

                </androidx.appcompat.widget.LinearLayoutCompat>

                <Button
                    android:id="@+id/ord_reserve_b_btnsend"
                    style="@style/Widget.MaterialComponents.Button"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="5dp"
                    android:backgroundTint="?attr/colorPrimary"
                    android:gravity="center"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:text="@string/reservebox_setreservebtn"
                    android:textColor="?attr/colorOnPrimary"
                    android:textSize="11sp"
                    android:textStyle="bold" />

            </androidx.appcompat.widget.LinearLayoutCompat>

            <!-- Reservation list title -->
            <TextView
                android:id="@+id/ord_reserve_b_statetv"
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:layout_marginStart="7dp"
                android:layout_marginTop="5dp"
                android:layout_marginEnd="7dp"
                android:background="?attr/colorSecondary"
                android:gravity="start|center_vertical"
                android:paddingStart="9dp"
                android:paddingEnd="9dp"
                android:text="@string/reservebox_tvlisttitle"
                android:textColor="@color/white"
                android:textSize="10sp"
                android:textStyle="bold" />

            <!-- Reservations -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/ord_reserve_b_recycler"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginStart="7dp"
                android:layout_marginTop="4dp"
                android:layout_marginEnd="7dp"
                android:layout_marginBottom="7dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:overScrollMode="never"
                android:padding="2dp"
                android:scrollbars="vertical"
                android:visibility="visible"
                tools:listitem="@android:layout/simple_list_item_1" />

        </androidx.appcompat.widget.LinearLayoutCompat>

    </com.google.android.material.card.MaterialCardView>

</LinearLayout>