<?xml version="1.0" encoding="utf-8"?>

<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/order_table_card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layoutDirection="rtl"
    android:layout_marginStart="3dp"
    android:layout_marginTop="2dp"
    android:layout_marginEnd="3dp"
    android:layout_marginBottom="2dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="?attr/colorSurface"
    app:cardCornerRadius="10dp"
    app:cardElevation="1dp"
    app:strokeColor="?attr/colorPrimary"
    app:strokeWidth="1dp">

    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layoutDirection="rtl"
        android:orientation="vertical"
        android:padding="6dp">

        <!-- Table name, capacity and clear -->
        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="48dp"
                android:layout_height="match_parent"
                android:gravity="start|center_vertical"
                android:paddingStart="4dp"
                android:text="@string/tableitem_name"
                android:textColor="?attr/colorOnBackground"
                android:textSize="9sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/ord_table_c_name"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:background="@drawable/bg_editbox"
                android:ellipsize="end"
                android:gravity="start|center_vertical"
                android:maxLines="1"
                android:paddingStart="7dp"
                android:paddingEnd="7dp"
                android:textColor="?attr/colorPrimary"
                android:textSize="11sp"
                android:textStyle="bold"
                tools:text="میز شماره ۱۲" />

            <TextView
                android:id="@+id/ord_table_c_placecount"
                android:layout_width="62dp"
                android:layout_height="38dp"
                android:layout_marginEnd="4dp"
                android:background="@drawable/bg_editbox"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:textColor="?attr/colorOnBackground"
                android:textSize="9sp"
                android:textStyle="bold"
                tools:text="۴ نفر" />

            <Button
                android:id="@+id/ord_table_c_cleartable"
                style="@style/Widget.MaterialComponents.Button"
                android:layout_width="74dp"
                android:layout_height="42dp"
                android:backgroundTint="@color/red_800"
                android:gravity="center"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:text="@string/tableitem_setfree"
                android:textColor="@color/white"
                android:textSize="8sp"
                android:textStyle="bold" />

        </androidx.appcompat.widget.LinearLayoutCompat>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:alpha="0.12"
            android:background="?attr/colorOnBackground" />

        <!-- Table explanation -->
        <LinearLayout
            android:id="@+id/ord_table_c_ll_mizexplain"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="visible">

            <TextView
                android:layout_width="78dp"
                android:layout_height="match_parent"
                android:gravity="start|center_vertical"
                android:paddingStart="5dp"
                android:text="@string/tableitem_tableexplain"
                android:textColor="?attr/colorOnBackground"
                android:textSize="9sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/ord_table_c_mizexplain"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_weight="1"
                android:background="@drawable/bg_editbox"
                android:ellipsize="end"
                android:gravity="start|center_vertical"
                android:maxLines="1"
                android:paddingStart="7dp"
                android:paddingEnd="7dp"
                android:textColor="?attr/colorOnBackground"
                android:textSize="9sp"
                android:textStyle="bold"
                tools:text="میز کنار پنجره" />

        </LinearLayout>

        <!-- Order explanation -->
        <LinearLayout
            android:id="@+id/ord_table_c_ll_infoexplain"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="visible">

            <TextView
                android:layout_width="78dp"
                android:layout_height="match_parent"
                android:gravity="start|center_vertical"
                android:paddingStart="5dp"
                android:text="@string/tableitem_infoexplain"
                android:textColor="?attr/colorOnBackground"
                android:textSize="9sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/ord_table_c_infoexplain"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_weight="1"
                android:background="@drawable/bg_editbox"
                android:ellipsize="end"
                android:gravity="start|center_vertical"
                android:maxLines="1"
                android:paddingStart="7dp"
                android:paddingEnd="7dp"
                android:textColor="?attr/colorOnBackground"
                android:textSize="9sp"
                android:textStyle="bold"
                tools:text="سفارش بدون نوشابه ارسال شود" />

        </LinearLayout>

        <!-- Active table information -->
        <LinearLayout
            android:id="@+id/ord_table_c_ll_timebroker"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="3dp"
            android:background="?attr/colorSecondary"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="5dp"
            android:paddingEnd="5dp"
            android:visibility="visible">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="16dp"
                    android:gravity="center"
                    android:text="@string/tableitem_usetime"
                    android:textColor="@color/white"
                    android:textSize="8sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/ord_table_c_time"
                    android:layout_width="match_parent"
                    android:layout_height="26dp"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:maxLines="1"
                    android:textColor="@color/white"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    tools:text="۰۱:۲۵" />

            </LinearLayout>

            <View
                android:layout_width="1dp"
                android:layout_height="32dp"
                android:alpha="0.35"
                android:background="@color/white" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="2"
                android:gravity="center_vertical"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="16dp"
                    android:gravity="center"
                    android:text="@string/tableitem_brokerstate"
                    android:textColor="@color/white"
                    android:textSize="8sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/ord_table_c_brokername"
                    android:layout_width="match_parent"
                    android:layout_height="26dp"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:maxLines="1"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:textColor="@color/white"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    tools:text="کاربر صندوق شماره ۱" />

            </LinearLayout>

        </LinearLayout>

        <!-- Reservation information -->
        <LinearLayout
            android:id="@+id/ord_table_c_ll_reserve"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_editbox"
            android:orientation="vertical"
            android:padding="5dp"
            android:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="58dp"
                    android:layout_height="match_parent"
                    android:gravity="start|center_vertical"
                    android:text="@string/tableitem_reserve"
                    android:textColor="?attr/colorOnBackground"
                    android:textSize="8sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/ord_table_c_reservestart"
                    android:layout_width="68dp"
                    android:layout_height="30dp"
                    android:background="?attr/colorSurface"
                    android:gravity="center"
                    android:textColor="?attr/colorPrimary"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    tools:text="۲۰:۰۰" />

                <TextView
                    android:id="@+id/ord_table_c_reservebrokername"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:gravity="start|center_vertical"
                    android:maxLines="1"
                    android:paddingStart="5dp"
                    android:paddingEnd="5dp"
                    android:textColor="?attr/colorOnBackground"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    tools:text="رزرو توسط صندوق" />

                <TextView
                    android:id="@+id/ord_table_c_reservemobileno"
                    android:layout_width="104dp"
                    android:layout_height="match_parent"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:maxLines="1"
                    android:textColor="?attr/colorOnBackground"
                    android:textDirection="ltr"
                    android:textSize="8sp"
                    android:textStyle="bold"
                    tools:text="09121234567" />

            </LinearLayout>

        </LinearLayout>

        <!-- Main actions -->
        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:orientation="horizontal">

            <Button
                android:id="@+id/ord_table_c_select"
                style="@style/Widget.MaterialComponents.Button"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginEnd="2dp"
                android:layout_weight="1"
                android:backgroundTint="?attr/colorPrimary"
                android:gravity="center"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingStart="5dp"
                android:paddingEnd="5dp"
                android:text="@string/tableitem_selecttable"
                android:textColor="?attr/colorOnPrimary"
                android:textSize="9sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/ord_table_c_btnreserve"
                style="@style/Widget.MaterialComponents.Button"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginStart="2dp"
                android:layout_weight="1"
                android:backgroundTint="?attr/colorSecondary"
                android:gravity="center"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingStart="5dp"
                android:paddingEnd="5dp"
                android:text="@string/tableitem_reservetable"
                android:textColor="@color/white"
                android:textSize="9sp"
                android:textStyle="bold" />

        </androidx.appcompat.widget.LinearLayoutCompat>

        <!-- Secondary actions -->
        <LinearLayout
            android:id="@+id/ord_table_c_ll_print_change"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center"
            android:orientation="horizontal">

            <Button
                android:id="@+id/ord_table_c_changemiz"
                style="@style/Widget.MaterialComponents.Button"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_marginEnd="2dp"
                android:layout_weight="1"
                android:backgroundTint="?attr/colorPrimary"
                android:gravity="center"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingStart="3dp"
                android:paddingEnd="3dp"
                android:text="@string/tableitem_changetable"
                android:textColor="?attr/colorOnPrimary"
                android:textSize="8sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/ord_table_c_explainedit"
                style="@style/Widget.MaterialComponents.Button"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_marginStart="2dp"
                android:layout_marginEnd="2dp"
                android:layout_weight="1"
                android:backgroundTint="?attr/colorPrimary"
                android:gravity="center"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingStart="3dp"
                android:paddingEnd="3dp"
                android:text="@string/tableitem_explinbtn"
                android:textColor="?attr/colorOnPrimary"
                android:textSize="8sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/ord_table_c_print"
                style="@style/Widget.MaterialComponents.Button"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_marginStart="2dp"
                android:layout_weight="1"
                android:backgroundTint="?attr/colorPrimary"
                android:gravity="center"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingStart="3dp"
                android:paddingEnd="3dp"
                android:text="@string/tableitem_print"
                android:textColor="?attr/colorOnPrimary"
                android:textSize="8sp"
                android:textStyle="bold" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:layout_marginTop="2dp"
            android:background="?attr/colorPrimary" />

    </androidx.appcompat.widget.LinearLayoutCompat>

</com.google.android.material.card.MaterialCardView>